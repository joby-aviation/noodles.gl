{
  "version": 1,
  "name": "earthquakes",
  "nodes": [
    { "id": "n1", "op": "file", "name": "quakes", "x": 0, "y": 0,
      "params": { "url": "@/quakes.csv", "format": "csv" } },
    { "id": "n2", "op": "attribute", "name": "position", "x": 300, "y": 0,
      "params": { "name": "position", "expression": "[Longitude, Latitude]" } },
    { "id": "n3", "op": "number", "name": "size", "x": 300, "y": 200, "params": { "value": 4 } },
    { "id": "n4", "op": "scatter", "name": "points", "x": 600, "y": 0,
      "params": { "position": "position", "radiusScale": { "expr": "ch('size/value') + sin(T)" } } },
    { "id": "n5", "op": "deck", "name": "deck", "x": 900, "y": 0, "params": {} }
  ],
  "edges": [
    { "id": "e1", "source": "n1", "sourcePort": "out", "target": "n2", "targetPort": "in" },
    { "id": "e2", "source": "n2", "sourcePort": "out", "target": "n4", "targetPort": "in" },
    { "id": "e3", "source": "n4", "sourcePort": "out", "target": "n5", "targetPort": "layers", "index": 0 }
  ],
  "timeline": { "tracks": [{ "target": "n4.opacity", "keys": [{ "time": 0, "value": 0 }, { "time": 2, "value": 1 }] }] }
}
