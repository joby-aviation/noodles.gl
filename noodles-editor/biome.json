{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/public",
      "!**/website/build",
      "!**/src/examples/nyc-census/data.json",
      "!**/bench/agent/.profile",
      "!**/bench/agent/results"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useKeyWithClickEvents": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noDebugger": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useExponentiationOperator": "off",
        "useNumberNamespace": "off",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["**/noodles.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/noodles/__migrations__/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["src/noodles/noodles.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["src/ai-chat/chat-panel.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/app.tsx",
        "src/noodles/components/basemap-gallery.tsx",
        "src/noodles/components/field-components.tsx",
        "src/noodles/components/geocoding-dialog.tsx",
        "src/noodles/components/graph-error-dialog.tsx",
        "src/noodles/components/multi-input-handle.tsx",
        "src/noodles/components/op-components.tsx",
        "src/noodles/components/ramp-editor.tsx",
        "src/noodles/components/schema-editor-dialog.tsx",
        "src/noodles/components/spreadsheet-pane/spreadsheet-viewer.tsx",
        "src/noodles/components/table-editor.tsx",
        "src/noodles/utils/use-undo-redo.ts",
        "src/timeline-editor.tsx",
        "src/timeline/components/CurvePopup.tsx",
        "src/timeline/components/KeyframeTrack.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noAutofocus": "warn",
            "noLabelWithoutControl": "warn",
            "noNoninteractiveElementToInteractiveRole": "warn",
            "noNoninteractiveTabindex": "warn",
            "noStaticElementInteractions": "warn",
            "useFocusableInteractive": "warn",
            "useSemanticElements": "warn"
          },
          "correctness": {
            "useExhaustiveDependencies": "warn"
          },
          "suspicious": {
            "noArrayIndexKey": "warn"
          }
        }
      }
    }
  ]
}
