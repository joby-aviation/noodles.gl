{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@noodles.gl/planner": [
        "../packages/planner/src/index.ts"
      ],
      "duckdb-browser-blocking": [
        "./node_modules/@duckdb/duckdb-wasm/dist/duckdb-browser-blocking.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}
