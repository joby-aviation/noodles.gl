      "position": {
        "x": 100,
        "y": 100
      },
      "data": {
        "inputs": {
          "kml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<kml xmlns=\"http://www.opengis.net/kml/2.2\">\n  <Document>\n    <name>Example Points</name>\n    <Placemark>\n      <name>San Francisco</name>\n      <Point>\n        <coordinates>-122.4194,37.7749,0</coordinates>\n      </Point>\n    </Placemark>\n    <Placemark>\n      <name>Los Angeles</name>\n      <Point>\n        <coordinates>-118.2437,34.0522,0</coordinates>\n      </Point>\n    </Placemark>\n    <Placemark>\n      <name>New York</name>\n      <Point>\n        <coordinates>-74.0060,40.7128,0</coordinates>\n      </Point>\n    </Placemark>\n  </Document>\n</kml>"
        }
      }
    },
    {
      "id": "/code-extract-features",
      "type": "CodeOp",
      "position": {
        "x": 250,
        "y": 100
      },
      "data": {
        "inputs": {
          "code": "return data.features"
        }
      }
    },
    {
