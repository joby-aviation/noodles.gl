      "type": "ScatterplotLayerOp",
      "position": {
        "x": 400,
        "y": 100
      },
      "data": {
        "inputs": {
          "data": [],
          "getPosition": "[d.geometry.coordinates[0], d.geometry.coordinates[1]]",
          "getRadius": 50000,
          "getFillColor": "[255, 100, 100]",
          "radiusMinPixels": 5,
          "radiusMaxPixels": 50
        }
      }
    },
    {
      "id": "/renderer",
      "type": "DeckRendererOp",
      "position": {
        "x": 700,
        "y": 100
      },
      "data": {
        "inputs": {
          "layers": [],
          "views": [],
          "basemap": null
        }
      }
    },
    {
