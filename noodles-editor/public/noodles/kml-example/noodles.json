      "type": "MapViewOp",
      "position": {
        "x": 400,
        "y": 300
      },
      "data": {
        "inputs": {
          "viewState": {
            "longitude": -98,
            "latitude": 38,
            "zoom": 3.5,
            "pitch": 0,
            "bearing": 0
          }
        }
      }
    },
    {
      "id": "/basemap",
