{
  "version": 1,
  "name": "SF Bike Parking Aggregation",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1146,
      "y": 123,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
        "projection": "mercator",
        "longitude": -122.4,
        "latitude": 37.74,
        "zoom": 13,
        "pitch": 30,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "switch",
      "op": "switch",
      "name": "switch",
      "x": 862,
      "y": 168,
      "params": {
        "index": 0
      }
    },
    {
      "id": "data-source",
      "op": "file",
      "name": "data-source",
      "x": 0,
      "y": 113,
      "params": {
        "url": "https://raw.githubusercontent.com/visgl/deck.gl-data/master/website/sf-bike-parking.json",
        "format": "json"
      }
    },
    {
      "id": "hexagon-layer",
      "op": "hexagon",
      "name": "hexagon-layer",
      "x": 578,
      "y": 104,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "position",
        "colorWeight": "SPACES",
        "elevationWeight": "SPACES",
        "radius": 200,
        "colorAggregation": "SUM",
        "upperPercentile": 100,
        "lowerPercentile": 0,
        "extruded": true,
        "elevationAggregation": "SUM",
        "elevationScale": 4
      }
    },
    {
      "id": "grid-layer",
      "op": "grid-layer",
      "name": "grid-layer",
      "x": 578,
      "y": 214,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "position",
        "colorWeight": "SPACES",
        "elevationWeight": "SPACES",
        "cellSize": 200,
        "colorAggregation": "SUM",
        "upperPercentile": 100,
        "lowerPercentile": 0,
        "extruded": true,
        "elevationAggregation": "SUM",
        "elevationScale": 4
      }
    },
    {
      "id": "position",
      "op": "attribute",
      "name": "position",
      "x": 284,
      "y": 104,
      "params": {
        "name": "position",
        "expression": "[item(COORDINATES, 0.0), item(COORDINATES, 1.0)]"
      }
    },
    {
      "id": "data-note",
      "op": "comment",
      "name": "data-note",
      "x": 0,
      "y": 28,
      "params": {
        "text": "This loads bike parking spots in San Francisco. Click it to see the data.",
        "width": 220,
        "height": 77
      }
    },
    {
      "id": "layers-note",
      "op": "comment",
      "name": "layers-note",
      "x": 578,
      "y": 0,
      "params": {
        "text": "Both layers count the bike spots in each area. Click one and change its Radius or Cell size.",
        "width": 220,
        "height": 96
      }
    },
    {
      "id": "switch-note",
      "op": "comment",
      "name": "switch-note",
      "x": 862,
      "y": 83,
      "params": {
        "text": "This picks which layer to show. Click it and change Index from 0 to 1.",
        "width": 220,
        "height": 77
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 1360,
      "y": 123,
      "params": {
        "text": "Try next:\n- Click hexagon-layer and change Elevation scale to make the bars taller.\n- Click the diamond next to Elevation scale, pick a later time in the Timeline, and change it again.\n- Press Export and pick Video (MP4) to save the animation.",
        "width": 340,
        "height": 155
      }
    }
  ],
  "edges": [
    {
      "id": "hexagon-layer.out->switch.in",
      "source": "hexagon-layer",
      "sourcePort": "out",
      "target": "switch",
      "targetPort": "in",
      "index": 0
    },
    {
      "id": "grid-layer.out->switch.in.1",
      "source": "grid-layer",
      "sourcePort": "out",
      "target": "switch",
      "targetPort": "in",
      "index": 1
    },
    {
      "id": "switch.out->deck.layers",
      "source": "switch",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "data-source.out->position.in",
      "source": "data-source",
      "sourcePort": "out",
      "target": "position",
      "targetPort": "in"
    },
    {
      "id": "position.out->hexagon-layer.in",
      "source": "position",
      "sourcePort": "out",
      "target": "hexagon-layer",
      "targetPort": "in"
    },
    {
      "id": "position.out->grid-layer.in",
      "source": "position",
      "sourcePort": "out",
      "target": "grid-layer",
      "targetPort": "in"
    }
  ]
}
