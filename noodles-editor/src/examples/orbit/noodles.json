{
  "version": 1,
  "name": "Orbit View 3D Scene",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 508,
      "y": 159,
      "params": {
        "basemap": "none",
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "dummy-data",
      "op": "generate",
      "name": "dummy-data",
      "x": 0,
      "y": 153,
      "params": {
        "count": 1,
        "name": "i"
      }
    },
    {
      "id": "scene",
      "op": "scenegraph",
      "name": "scene",
      "x": 224,
      "y": 144,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "[0.0, 0.0, 0.0]",
        "color": "",
        "modelColor": [
          255,
          255,
          255
        ],
        "orientation": "[0, 0, 90]",
        "scale": "",
        "translation": "",
        "scenegraph": "https://raw.githubusercontent.com/visgl/deck.gl-data/master/examples/scenegraph-layer/airplane.glb",
        "sizeScale": 1,
        "sizeMinPixels": 0,
        "sizeMaxPixels": 100
      }
    },
    {
      "id": "camera",
      "op": "orbit-view",
      "name": "camera",
      "x": 224,
      "y": 254,
      "params": {
        "clear": true,
        "clearColor": "#2997ffff",
        "fovy": 50
      }
    },
    {
      "id": "spin",
      "op": "number",
      "name": "spin",
      "x": -224,
      "y": 300,
      "params": {
        "value": 210
      }
    },
    {
      "id": "view",
      "op": "CodeOp",
      "name": "view",
      "x": 0,
      "y": 300,
      "params": {
        "code": [
          "// The camera, turned by spin (keyframed on the timeline)",
          "return { target: [0, 0, 0], zoom: 4, rotationX: 25, rotationOrbit: d }"
        ]
      }
    },
    {
      "id": "model-note",
      "op": "comment",
      "name": "model-note",
      "x": 224,
      "y": 0,
      "params": {
        "text": "This draws a 3D airplane model on a plain background, with no map. The model is Y-up, so scene rolls it 90° to sit level. Put a link to another .glb model in Model URL (glTF) on scene to swap it.",
        "width": 220,
        "height": 156
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 722,
      "y": 159,
      "params": {
        "text": "Try next:\n- Press play: spin turns the camera a full circle, then holds.\n- Drag spin's keyframes on the timeline to change the timing.\n- Click camera and change Clear Color to set the background.\n- Press Export and pick Video to save the animation.",
        "width": 340,
        "height": 136
      }
    }
  ],
  "edges": [
    {
      "id": "scene.out->deck.layers",
      "source": "scene",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "camera.view->deck.views",
      "source": "camera",
      "sourcePort": "view",
      "target": "deck",
      "targetPort": "views",
      "index": 0
    },
    {
      "id": "dummy-data.out->scene.in",
      "source": "dummy-data",
      "sourcePort": "out",
      "target": "scene",
      "targetPort": "in"
    },
    {
      "id": "spin.out->view.par:data",
      "source": "spin",
      "sourcePort": "out",
      "target": "view",
      "targetPort": "par:data"
    },
    {
      "id": "view.data->camera.par:viewState",
      "source": "view",
      "sourcePort": "data",
      "target": "camera",
      "targetPort": "par:viewState"
    }
  ],
  "timeline": {
    "length": 4,
    "fps": 30,
    "tracks": [
      {
        "target": "spin.value",
        "keyframes": [
          {
            "id": "spin-start",
            "time": 0.6,
            "value": 210,
            "interpolation": "bezier",
            "handles": {
              "left": [
                0.8,
                0
              ],
              "right": [
                0.2,
                1
              ]
            }
          },
          {
            "id": "spin-end",
            "time": 1.9,
            "value": 570,
            "interpolation": "hold",
            "handles": {
              "left": [
                0.42,
                0
              ],
              "right": [
                0.58,
                1
              ]
            }
          }
        ]
      }
    ]
  }
}
