{
  "version": 1,
  "name": "Orbit View 3D Scene",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 580,
      "y": 57,
      "params": {
        "basemap": "none",
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "dummy-data",
      "op": "generate",
      "name": "dummy-data",
      "x": 0,
      "y": 102,
      "params": {
        "count": 1,
        "name": "i"
      }
    },
    {
      "id": "scene",
      "op": "scenegraph",
      "name": "scene",
      "x": 200,
      "y": 98,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "[0.0, 0.0, 0.0]",
        "color": "",
        "modelColor": [
          255,
          255,
          255
        ],
        "orientation": "",
        "scale": "",
        "translation": "",
        "scenegraph": "https://raw.githubusercontent.com/visgl/deck.gl-data/master/examples/scenegraph-layer/airplane.glb",
        "sizeScale": 1,
        "sizeMinPixels": 10,
        "sizeMaxPixels": 100
      }
    },
    {
      "id": "camera",
      "op": "orbit-view",
      "name": "camera",
      "x": 200,
      "y": 204,
      "params": {
        "clear": true,
        "clearColor": "#2997ffff",
        "fovy": 50
      }
    },
    {
      "id": "model-note",
      "op": "comment",
      "name": "model-note",
      "x": 200,
      "y": 0,
      "params": {
        "text": "This draws a 3D airplane model on a plain background, with no map. Put a link to another .glb model in Model URL (glTF) on scene to swap it.",
        "width": 340,
        "height": 90
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 770,
      "y": 61,
      "params": {
        "text": "Try next:\n- Click camera and change Clear Color to set the background.\n- Click scene and change Color to tint the model.\n- Press Export and pick Image (PNG) to save it.",
        "width": 340,
        "height": 150
      }
    }
  ],
  "edges": [
    {
      "id": "scene.out->deck.layers",
      "source": "scene",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "camera.view->deck.views",
      "source": "camera",
      "sourcePort": "view",
      "target": "deck",
      "targetPort": "views",
      "index": 0
    },
    {
      "id": "dummy-data.out->scene.in",
      "source": "dummy-data",
      "sourcePort": "out",
      "target": "scene",
      "targetPort": "in"
    }
  ]
}
