{
  "version": 1,
  "name": "NYC Census",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1367,
      "y": 195,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
        "projection": "mercator",
        "longitude": -73.91554,
        "latitude": 40.70103,
        "zoom": 11.98,
        "pitch": 59.11,
        "bearing": -91.5,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "data-source",
      "op": "geojson",
      "name": "data-source",
      "x": 0,
      "y": 85,
      "params": {
        "url": "@/data.json"
      }
    },
    {
      "id": "geojson-layer",
      "op": "polygon",
      "name": "geojson-layer",
      "x": 1073,
      "y": 121,
      "params": {
        "opacity": 0.7,
        "blend": "normal",
        "position": "geom",
        "color": "population_color",
        "lineColorChannel": "",
        "lineColor": [
          0,
          0,
          0
        ],
        "filled": true,
        "stroked": false,
        "lineWidthScale": 1,
        "lineWidthUnits": "meters",
        "lineWidthMinPixels": 0,
        "extruded": true,
        "elevation": "population_to_elevation",
        "elevationScale": 11
      }
    },
    {
      "id": "geojson-layer-lines",
      "op": "path",
      "name": "geojson-layer-lines",
      "x": 1073,
      "y": 231,
      "params": {
        "opacity": 0.7,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "lineColor": [
          0,
          0,
          0
        ],
        "widthScale": 1,
        "widthUnits": "meters",
        "widthMinPixels": 0
      }
    },
    {
      "id": "geojson-layer-points",
      "op": "scatter",
      "name": "geojson-layer-points",
      "x": 1073,
      "y": 341,
      "params": {
        "opacity": 0.7,
        "blend": "normal",
        "position": "geom",
        "color": "population_color",
        "radius": "",
        "radiusScale": 1,
        "radiusUnits": "meters"
      }
    },
    {
      "id": "map-range",
      "op": "map-range",
      "name": "map-range",
      "x": 284,
      "y": 121,
      "params": {
        "input": "Population",
        "name": "map_range",
        "kind": "linear",
        "clamp": false,
        "inMin": 0,
        "inMax": 10000,
        "outMin": 0,
        "outMax": 1
      }
    },
    {
      "id": "population-color",
      "op": "color-ramp",
      "name": "population-color",
      "x": 521,
      "y": 121,
      "params": {
        "input": "map_range",
        "ramp": "turbo",
        "min": 0,
        "max": 1,
        "name": "population_color"
      }
    },
    {
      "id": "population-to-elevation",
      "op": "map-range",
      "name": "population-to-elevation",
      "x": 779,
      "y": 121,
      "params": {
        "input": "Population",
        "name": "population_to_elevation",
        "kind": "linear",
        "clamp": false,
        "inMin": 0,
        "inMax": 10000,
        "outMin": 0,
        "outMax": 200
      }
    },
    {
      "id": "data-note",
      "op": "comment",
      "name": "data-note",
      "x": 0,
      "y": 0,
      "params": {
        "text": "This loads New York City census tracts, each with its population.",
        "width": 220,
        "height": 77
      }
    },
    {
      "id": "layer-note",
      "op": "comment",
      "name": "layer-note",
      "x": 1073,
      "y": 17,
      "params": {
        "text": "This layer draws each tract, colored and raised by its population. Click it and change Elevation scale.",
        "width": 230,
        "height": 96
      }
    },
    {
      "id": "height-note",
      "op": "comment",
      "name": "height-note",
      "x": 779,
      "y": 17,
      "params": {
        "text": "population-to-elevation turns population into a height. Change Out max to make the tallest tracts taller.",
        "width": 230,
        "height": 96
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 1581,
      "y": 195,
      "params": {
        "text": "Try next:\n- Click population-color and pick a different Ramp.\n- Click the diamond next to Elevation scale on geojson-layer, pick a later time in the Timeline, and change it again.\n- Press Export and pick Video (MP4) to save the animation.",
        "width": 340,
        "height": 175
      }
    }
  ],
  "edges": [
    {
      "id": "geojson-layer.out->deck.layers",
      "source": "geojson-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "geojson-layer-lines.out->deck.layers.1",
      "source": "geojson-layer-lines",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 1
    },
    {
      "id": "geojson-layer-points.out->deck.layers.2",
      "source": "geojson-layer-points",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 2
    },
    {
      "id": "data-source.features->map-range.in",
      "source": "data-source",
      "sourcePort": "features",
      "target": "map-range",
      "targetPort": "in"
    },
    {
      "id": "map-range.out->population-color.in",
      "source": "map-range",
      "sourcePort": "out",
      "target": "population-color",
      "targetPort": "in"
    },
    {
      "id": "population-color.out->population-to-elevation.in",
      "source": "population-color",
      "sourcePort": "out",
      "target": "population-to-elevation",
      "targetPort": "in"
    },
    {
      "id": "population-to-elevation.out->geojson-layer.in",
      "source": "population-to-elevation",
      "sourcePort": "out",
      "target": "geojson-layer",
      "targetPort": "in"
    },
    {
      "id": "population-to-elevation.out->geojson-layer-lines.in",
      "source": "population-to-elevation",
      "sourcePort": "out",
      "target": "geojson-layer-lines",
      "targetPort": "in"
    },
    {
      "id": "population-to-elevation.out->geojson-layer-points.in",
      "source": "population-to-elevation",
      "sourcePort": "out",
      "target": "geojson-layer-points",
      "targetPort": "in"
    }
  ]
}
