{
  "version": 1,
  "name": "GeoJSON BART Stations",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 400,
      "y": 0,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
        "projection": "mercator",
        "longitude": -122.169,
        "latitude": 37.74,
        "zoom": 11,
        "pitch": 34,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "data-source",
      "op": "geojson",
      "name": "data-source",
      "x": -395.9478357380689,
      "y": -300.04661487236405,
      "params": {
        "url": "https://raw.githubusercontent.com/visgl/deck.gl-data/master/website/bart.geo.json"
      }
    },
    {
      "id": "fill-color",
      "op": "color",
      "name": "fill-color",
      "x": -400,
      "y": 17.466148723640398,
      "params": {
        "color": [
          1,
          1,
          126
        ]
      }
    },
    {
      "id": "geojson-layer",
      "op": "polygon",
      "name": "geojson-layer",
      "x": 44,
      "y": -300,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "fillColor": {
          "ref": "fill-color/color"
        },
        "lineColorChannel": "line_color",
        "filled": true,
        "stroked": false,
        "lineWidthScale": 100,
        "lineWidthUnits": "meters",
        "lineWidthMinPixels": 4,
        "extruded": true,
        "elevation": "",
        "elevationScale": 30
      }
    },
    {
      "id": "geojson-layer-lines",
      "op": "path",
      "name": "geojson-layer-lines",
      "x": 44,
      "y": -140,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "geom",
        "color": "line_color",
        "widthScale": 100,
        "widthUnits": "meters",
        "widthMinPixels": 4
      }
    },
    {
      "id": "geojson-layer-points",
      "op": "scatter",
      "name": "geojson-layer-points",
      "x": 44,
      "y": 20,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "fillColor": {
          "ref": "fill-color/color"
        },
        "radius": "",
        "radiusScale": 4,
        "radiusUnits": "meters"
      }
    },
    {
      "id": "geojson-layer-labels",
      "op": "text",
      "name": "geojson-layer-labels",
      "x": 44,
      "y": 100,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "geom",
        "text": "name",
        "size": 32,
        "textColor": [
          0,
          0,
          0
        ],
        "offsetY": 0
      }
    },
    {
      "id": "line-color",
      "op": "attribute",
      "name": "line-color",
      "x": -176,
      "y": -300.04661487236405,
      "params": {
        "name": "line_color",
        "expression": "hex_color(coalesce(color, '#000'))"
      }
    },
    {
      "id": "/data-note",
      "type": "CommentOp",
      "position": {
        "x": -396,
        "y": -420
      },
      "data": {
        "inputs": {
          "text": "This loads BART train lines and stations in the San Francisco Bay Area from a GeoJSON file."
        },
        "locked": false
      },
      "width": 300,
      "height": 90
    },
    {
      "id": "/layer-note",
      "type": "CommentOp",
      "position": {
        "x": 0,
        "y": -420
      },
      "data": {
        "inputs": {
          "text": "One layer draws the stations, their names, and the train lines. Click it and change lineWidthMinPixels."
        },
        "locked": false
      },
      "width": 320,
      "height": 90
    },
    {
      "id": "/line-color-note",
      "type": "CommentOp",
      "position": {
        "x": -400,
        "y": 235
      },
      "data": {
        "inputs": {
          "text": "This colors each train line with the color stored in its data."
        },
        "locked": false
      },
      "width": 314,
      "height": 80
    },
    {
      "id": "/try-next-note",
      "type": "CommentOp",
      "position": {
        "x": 696,
        "y": 120
      },
      "data": {
        "inputs": {
          "text": "Try next:\n- Click fill-color and pick a new color.\n- Drop your own GeoJSON file onto the canvas to map it.\n- Press Export and pick Image (PNG) to save the map."
        },
        "locked": false
      },
      "width": 340,
      "height": 150
    }
