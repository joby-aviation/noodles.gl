{
  "version": 1,
  "name": "GeoJSON BART Stations",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1054,
      "y": 172,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
        "projection": "mercator",
        "longitude": -122.169,
        "latitude": 37.74,
        "zoom": 11,
        "pitch": 34,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "data-source",
      "op": "geojson",
      "name": "data-source",
      "x": 0,
      "y": 221,
      "params": {
        "url": "https://raw.githubusercontent.com/visgl/deck.gl-data/master/website/bart.geo.json"
      }
    },
    {
      "id": "fill-color",
      "op": "color",
      "name": "fill-color",
      "x": 340,
      "y": 317,
      "params": {
        "color": [
          1,
          1,
          126
        ]
      }
    },
    {
      "id": "geojson-layer",
      "op": "polygon",
      "name": "geojson-layer",
      "x": 694,
      "y": 310,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "fillColor": {
          "ref": "fill-color/color"
        },
        "lineColorChannel": "line_color",
        "filled": true,
        "stroked": false,
        "lineWidthScale": 100,
        "lineWidthUnits": "meters",
        "lineWidthMinPixels": 4,
        "extruded": true,
        "elevation": "",
        "elevationScale": 30
      }
    },
    {
      "id": "geojson-layer-lines",
      "op": "path",
      "name": "geojson-layer-lines",
      "x": 694,
      "y": 0,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "geom",
        "color": "line_color",
        "widthScale": 100,
        "widthUnits": "meters",
        "widthMinPixels": 4
      }
    },
    {
      "id": "geojson-layer-points",
      "op": "scatter",
      "name": "geojson-layer-points",
      "x": 694,
      "y": 416,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "fillColor": {
          "ref": "fill-color/color"
        },
        "radius": "",
        "radiusScale": 4,
        "radiusUnits": "meters"
      }
    },
    {
      "id": "geojson-layer-labels",
      "op": "text",
      "name": "geojson-layer-labels",
      "x": 694,
      "y": 106,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "geom",
        "text": "name",
        "size": 32,
        "textColor": [
          0,
          0,
          0
        ],
        "offsetY": 0
      }
    },
    {
      "id": "line-color",
      "op": "attribute",
      "name": "line-color",
      "x": 340,
      "y": 123,
      "params": {
        "name": "line_color",
        "expression": "hex_color(coalesce(color, '#000'))"
      }
    },
    {
      "id": "data-note",
      "op": "comment",
      "name": "data-note",
      "x": 0,
      "y": 123,
      "params": {
        "text": "This loads BART train lines and stations in the San Francisco Bay Area from a GeoJSON file.",
        "width": 300,
        "height": 90
      }
    },
    {
      "id": "layer-note",
      "op": "comment",
      "name": "layer-note",
      "x": 694,
      "y": 212,
      "params": {
        "text": "These four layers draw the stations, their names, and the train lines. Click geojson-layer-lines and change Min width (px).",
        "width": 320,
        "height": 90
      }
    },
    {
      "id": "line-color-note",
      "op": "comment",
      "name": "line-color-note",
      "x": 340,
      "y": 229,
      "params": {
        "text": "line-color gives each train line the color stored in its data.",
        "width": 314,
        "height": 80
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 1244,
      "y": 176,
      "params": {
        "text": "Try next:\n- Click fill-color and pick a new color.\n- Drop your own GeoJSON file onto the canvas to map it.\n- Press Export and pick Image (PNG) to save the map.",
        "width": 340,
        "height": 150
      }
    }
  ],
  "edges": [
    {
      "id": "geojson-layer.out->deck.layers",
      "source": "geojson-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "geojson-layer-lines.out->deck.layers.1",
      "source": "geojson-layer-lines",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 1
    },
    {
      "id": "geojson-layer-points.out->deck.layers.2",
      "source": "geojson-layer-points",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 2
    },
    {
      "id": "geojson-layer-labels.out->deck.layers.3",
      "source": "geojson-layer-labels",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 3
    },
    {
      "id": "data-source.features->line-color.in",
      "source": "data-source",
      "sourcePort": "features",
      "target": "line-color",
      "targetPort": "in"
    },
    {
      "id": "line-color.out->geojson-layer.in",
      "source": "line-color",
      "sourcePort": "out",
      "target": "geojson-layer",
      "targetPort": "in"
    },
    {
      "id": "line-color.out->geojson-layer-lines.in",
      "source": "line-color",
      "sourcePort": "out",
      "target": "geojson-layer-lines",
      "targetPort": "in"
    },
    {
      "id": "line-color.out->geojson-layer-points.in",
      "source": "line-color",
      "sourcePort": "out",
      "target": "geojson-layer-points",
      "targetPort": "in"
    },
    {
      "id": "line-color.out->geojson-layer-labels.in",
      "source": "line-color",
      "sourcePort": "out",
      "target": "geojson-layer-labels",
      "targetPort": "in"
    }
  ]
}
