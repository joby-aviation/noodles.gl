{
  "nodes": [
    {
      "id": "/data-source",
      "type": "FileOp",
      "data": {
        "inputs": {
          "format": "csv",
          "url": "@/data.csv"
        }
      },
      "position": {
        "x": 200,
        "y": 100
      }
    },
    {
      "id": "/maplibre-basemap",
      "type": "MaplibreBasemapOp",
      "data": {
        "inputs": {
          "mapStyle": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
          "viewState": {
            "latitude": 37.059,
            "longitude": -119.963,
            "zoom": 7
          }
        }
      },
      "position": {
        "x": 3400,
        "y": 340
      }
    },
    {
      "id": "/create-position",
      "type": "CreateAttributeOp",
      "data": {
        "inputs": {
          "name": "position",
          "expression": "[d.Longitude, d.Latitude, 0]",
          "size": 3
        }
      },
      "position": {
        "x": 600,
        "y": 100
      }
    },
    {
      "id": "/scatterplot-layer",
      "type": "ScatterplotLayerOp",
      "data": {
        "inputs": {
          "stroked": false,
          "billboard": true,
          "radiusUnits": "meters"
        }
      },
      "position": {
        "x": 3000,
        "y": 100
      }
    },
    {
      "id": "/deck",
      "type": "DeckRendererOp",
      "data": {
        "inputs": {}
      },
      "position": {
        "x": 3400,
        "y": 100
      }
    },
    {
      "id": "/out",
      "type": "OutOp",
      "data": {
        "inputs": {}
      },
      "position": {
        "x": 3800,
        "y": 100
      }
    },
    {
      "id": "/create-magnitude",
      "type": "CreateAttributeOp",
      "data": {
        "inputs": {
          "name": "magnitude",
          "expression": "d.Magnitude",
          "size": 1,
          "type": "float32"
        }
      },
      "position": {
        "x": 1000,
        "y": 100
      }
    },
    {
      "id": "/map-radius",
      "type": "MapRangeOp",
      "data": {
        "inputs": {
          "inputAttribute": "magnitude",
          "outputAttribute": "radius",
          "inMin": 2.5,
          "inMax": 7,
          "outMin": 500,
          "outMax": 10000
        }
      },
      "position": {
        "x": 1400,
        "y": 100
      }
    },
    {
      "id": "/map-color-input",
      "type": "MapRangeOp",
      "data": {
        "inputs": {
          "inputAttribute": "magnitude",
          "outputAttribute": "normalizedMagnitude",
          "inMin": 2.5,
          "inMax": 7,
          "outMin": 0,
          "outMax": 1
        }
      },
      "position": {
        "x": 1800,
        "y": 100
      }
    },
    {
      "id": "/color-ramp",
      "type": "ColorRampOp",
      "data": {
        "inputs": {
          "inputAttribute": "normalizedMagnitude",
          "outputAttribute": "fillColor",
          "colorScheme": "turbo"
        }
      },
      "position": {
        "x": 2200,
        "y": 100
      }
    }
  ],
  "edges": [
    {
      "id": "/data-source.out.data->/create-position.par.data",
      "source": "/data-source",
      "sourceHandle": "out.data",
      "target": "/create-position",
      "targetHandle": "par.data"
    },
    {
      "id": "/scatterplot-layer.out.layer->/deck.par.layers",
      "source": "/scatterplot-layer",
      "sourceHandle": "out.layer",
      "target": "/deck",
      "targetHandle": "par.layers"
    },
    {
      "id": "/maplibre-basemap.out.maplibre->/deck.par.basemap",
      "source": "/maplibre-basemap",
      "sourceHandle": "out.maplibre",
      "target": "/deck",
      "targetHandle": "par.basemap"
    },
    {
      "id": "/deck.out.vis->/out.par.vis",
      "source": "/deck",
      "sourceHandle": "out.vis",
      "target": "/out",
      "targetHandle": "par.vis"
    },
    {
      "id": "/create-position.out.data->/create-magnitude.par.data",
      "source": "/create-position",
      "sourceHandle": "out.data",
      "target": "/create-magnitude",
      "targetHandle": "par.data"
    },
    {
      "id": "/create-magnitude.out.data->/map-radius.par.data",
      "source": "/create-magnitude",
      "sourceHandle": "out.data",
      "target": "/map-radius",
      "targetHandle": "par.data"
    },
    {
      "id": "/map-radius.out.data->/map-color-input.par.data",
      "source": "/map-radius",
      "sourceHandle": "out.data",
      "target": "/map-color-input",
      "targetHandle": "par.data"
    },
    {
      "id": "/map-color-input.out.data->/color-ramp.par.data",
      "source": "/map-color-input",
      "sourceHandle": "out.data",
      "target": "/color-ramp",
      "targetHandle": "par.data"
    },
    {
      "id": "/color-ramp.out.data->/scatterplot-layer.par.data",
      "source": "/color-ramp",
      "sourceHandle": "out.data",
      "target": "/scatterplot-layer",
      "targetHandle": "par.data"
    }
  ],
  "viewport": {
    "x": -200,
    "y": -50,
    "zoom": 0.5
  },
  "version": 15,
  "name": "California Earthquakes"
}
