{
  "nodes": [
    {
      "id": "/data-source",
      "type": "FileOp",
      "data": {
        "inputs": {
          "format": "csv",
          "url": "@/data.csv"
        }
      },
      "position": {
        "x": 100,
        "y": 100
      }
    },
    {
      "id": "/maplibre-basemap",
      "type": "MaplibreBasemapOp",
      "data": {
        "inputs": {
          "mapStyle": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
          "viewState": {
            "latitude": 37.059,
            "longitude": -119.963,
            "zoom": 7
          }
        }
      },
      "position": {
        "x": 100,
        "y": 450
      }
    },
    {
      "id": "/create-position",
      "type": "CreateAttributeOp",
      "data": {
        "inputs": {
          "name": "position",
          "expression": "[d.Longitude, d.Latitude, 0]",
          "size": 3
        }
      },
      "position": {
        "x": 500,
        "y": 100
      }
    },
    {
      "id": "/create-radius",
      "type": "CreateAttributeOp",
      "data": {
        "inputs": {
          "name": "radius",
          "expression": "Math.sqrt(d.Magnitude) * 1000",
          "size": 1
        }
      },
      "position": {
        "x": 900,
        "y": 100
      }
    },
    {
      "id": "/create-color",
      "type": "CreateAttributeOp",
      "data": {
        "inputs": {
          "name": "fillColor",
          "expression": "(() => { const rgb = d3.color(d3.interpolateTurbo((d.Magnitude - 2.5) / 4.5)).rgb(); return [rgb.r, rgb.g, rgb.b, 255]; })()",
          "size": 4,
          "type": "uint8"
        }
      },
      "position": {
        "x": 1300,
        "y": 100
      }
    },
    {
      "id": "/scatterplot-layer",
      "type": "ScatterplotLayerOp",
      "data": {
        "inputs": {
          "stroked": false,
          "billboard": true,
          "radiusUnits": "meters"
        }
      },
      "position": {
        "x": 1700,
        "y": 100
      }
    },
    {
      "id": "/deck",
      "type": "DeckRendererOp",
      "data": {
        "inputs": {}
      },
      "position": {
        "x": 2100,
        "y": 100
      }
    },
    {
      "id": "/out",
      "type": "OutOp",
      "data": {
        "inputs": {}
      },
      "position": {
        "x": 2500,
        "y": 100
      }
    }
  ],
  "edges": [
    {
      "id": "/data-source.out.data->/create-position.par.data",
      "source": "/data-source",
      "sourceHandle": "out.data",
      "target": "/create-position",
      "targetHandle": "par.data"
    },
    {
      "id": "/create-position.out.data->/create-radius.par.data",
      "source": "/create-position",
      "sourceHandle": "out.data",
      "target": "/create-radius",
      "targetHandle": "par.data"
    },
    {
      "id": "/create-radius.out.data->/create-color.par.data",
      "source": "/create-radius",
      "sourceHandle": "out.data",
      "target": "/create-color",
      "targetHandle": "par.data"
    },
    {
      "id": "/create-color.out.data->/scatterplot-layer.par.data",
      "source": "/create-color",
      "sourceHandle": "out.data",
      "target": "/scatterplot-layer",
      "targetHandle": "par.data"
    },
    {
      "id": "/scatterplot-layer.out.layer->/deck.par.layers",
      "source": "/scatterplot-layer",
      "sourceHandle": "out.layer",
      "target": "/deck",
      "targetHandle": "par.layers"
    },
    {
      "id": "/maplibre-basemap.out.maplibre->/deck.par.basemap",
      "source": "/maplibre-basemap",
      "sourceHandle": "out.maplibre",
      "target": "/deck",
      "targetHandle": "par.basemap"
    },
    {
      "id": "/deck.out.vis->/out.par.vis",
      "source": "/deck",
      "sourceHandle": "out.vis",
      "target": "/out",
      "targetHandle": "par.vis"
    }
  ],
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 0.8
  },
  "version": 14
}
