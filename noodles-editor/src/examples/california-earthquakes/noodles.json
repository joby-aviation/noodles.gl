{
  "version": 1,
  "name": "California Earthquakes",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1852,
      "y": 68,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
        "projection": "mercator",
        "longitude": -119.963,
        "latitude": 37.059,
        "zoom": 7,
        "pitch": 0,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "data-source",
      "op": "file",
      "name": "data-source",
      "x": 0,
      "y": 113,
      "params": {
        "url": "@/data.csv",
        "format": "csv"
      }
    },
    {
      "id": "scatterplot-layer",
      "op": "scatter",
      "name": "scatterplot-layer",
      "x": 1566,
      "y": 104,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "position",
        "color": "magnitude_color",
        "radius": "multiply",
        "radiusScale": 1,
        "radiusUnits": "meters"
      }
    },
    {
      "id": "position",
      "op": "attribute",
      "name": "position",
      "x": 284,
      "y": 104,
      "params": {
        "name": "position",
        "expression": "[Longitude, Latitude]"
      }
    },
    {
      "id": "map-range",
      "op": "map-range",
      "name": "map-range",
      "x": 563,
      "y": 104,
      "params": {
        "input": "Magnitude",
        "name": "map_range",
        "kind": "linear",
        "clamp": false,
        "inMin": 2.5,
        "inMax": 7,
        "outMin": 0,
        "outMax": 1
      }
    },
    {
      "id": "magnitude-color",
      "op": "color-ramp",
      "name": "magnitude-color",
      "x": 847,
      "y": 104,
      "params": {
        "input": "map_range",
        "ramp": "turbo",
        "min": 0,
        "max": 1,
        "name": "magnitude_color"
      }
    },
    {
      "id": "sqrt",
      "op": "attribute",
      "name": "sqrt",
      "x": 1105,
      "y": 104,
      "params": {
        "name": "sqrt",
        "expression": "sqrt(Magnitude)"
      }
    },
    {
      "id": "multiply",
      "op": "attribute",
      "name": "multiply",
      "x": 1323,
      "y": 104,
      "params": {
        "name": "multiply",
        "expression": "(sqrt * 1700.0)"
      }
    },
    {
      "id": "data-note",
      "op": "comment",
      "name": "data-note",
      "x": 0,
      "y": 28,
      "params": {
        "text": "This loads the earthquake CSV. Click it to see its columns.",
        "width": 220,
        "height": 77
      }
    },
    {
      "id": "magnitude-note",
      "op": "comment",
      "name": "magnitude-note",
      "x": 563,
      "y": 0,
      "params": {
        "text": "This reads each earthquake's magnitude. The nodes to its right turn it into a circle color and size.",
        "width": 220,
        "height": 96
      }
    },
    {
      "id": "layer-note",
      "op": "comment",
      "name": "layer-note",
      "x": 1566,
      "y": 0,
      "params": {
        "text": "This layer draws one circle per earthquake. Click it and change Radius scale to make the circles bigger.",
        "width": 222,
        "height": 96
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 2066,
      "y": 68,
      "params": {
        "text": "Try next:\n- Click magnitude-color and pick a different Ramp.\n- Drop a CSV with latitude and longitude columns onto the canvas to map your own points.\n- Press Export and pick Image (PNG) to save the map.",
        "width": 340,
        "height": 175
      }
    }
  ],
  "edges": [
    {
      "id": "scatterplot-layer.out->deck.layers",
      "source": "scatterplot-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "data-source.out->position.in",
      "source": "data-source",
      "sourcePort": "out",
      "target": "position",
      "targetPort": "in"
    },
    {
      "id": "position.out->map-range.in",
      "source": "position",
      "sourcePort": "out",
      "target": "map-range",
      "targetPort": "in"
    },
    {
      "id": "map-range.out->magnitude-color.in",
      "source": "map-range",
      "sourcePort": "out",
      "target": "magnitude-color",
      "targetPort": "in"
    },
    {
      "id": "magnitude-color.out->sqrt.in",
      "source": "magnitude-color",
      "sourcePort": "out",
      "target": "sqrt",
      "targetPort": "in"
    },
    {
      "id": "sqrt.out->multiply.in",
      "source": "sqrt",
      "sourcePort": "out",
      "target": "multiply",
      "targetPort": "in"
    },
    {
      "id": "multiply.out->scatterplot-layer.in",
      "source": "multiply",
      "sourcePort": "out",
      "target": "scatterplot-layer",
      "targetPort": "in"
    }
  ]
}
