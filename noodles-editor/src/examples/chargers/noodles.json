{
  "version": 1,
  "name": "EV Chargers with Live API Data",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1540,
      "y": 106,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/dark-matter-nolabels-gl-style/style.json",
        "projection": "mercator",
        "longitude": -74.006,
        "latitude": 40.7128,
        "zoom": 12,
        "pitch": 0,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "layer-toggle",
      "op": "switch",
      "name": "layer-toggle",
      "x": 1210,
      "y": 257,
      "params": {
        "index": 0
      }
    },
    {
      "id": "charger-query",
      "op": "sql",
      "name": "charger-query",
      "x": 340,
      "y": 168,
      "params": {
        "query": "SELECT AddressInfo.Latitude as lat, AddressInfo.Longitude as lng, *\nFROM read_json_auto(printf('https://api.openchargemap.io/v3/poi/?client=ocm.app.ionic.8.7.0&verbose=false&output=json&maxresults=1000&compact=true&boundingbox=(%f,%f),(%f,%f)&key=%s', ch('centroid/out.location.lat') + 0.5, ch('centroid/out.location.lng') - 0.5, ch('centroid/out.location.lat') - 0.5, ch('centroid/out.location.lng') + 0.5,\n'3967da06-b05f-47b5-8c83-f52cdf1065c2\n'))"
      }
    },
    {
      "id": "charger-points",
      "op": "scatter",
      "name": "charger-points",
      "x": 955,
      "y": 178,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "charger_position",
        "color": "",
        "fillColor": [
          255,
          89,
          0
        ],
        "radius": "",
        "radiusScale": 10,
        "radiusUnits": "pixels"
      }
    },
    {
      "id": "charger-heatmap",
      "op": "heatmap",
      "name": "charger-heatmap",
      "x": 955,
      "y": 284,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "charger_position",
        "weight": "",
        "weightConstant": 5.4,
        "aggregation": "SUM",
        "radiusPixels": 100,
        "intensity": 1,
        "threshold": 0.05
      }
    },
    {
      "id": "auto-view",
      "op": "view-state",
      "name": "auto-view",
      "x": 1210,
      "y": 45,
      "params": {
        "zoom": 10.8
      }
    },
    {
      "id": "charger-bounds",
      "op": "fit-bounds",
      "name": "charger-bounds",
      "x": 955,
      "y": 0,
      "params": {
        "padding": 200
      }
    },
    {
      "id": "centroid",
      "op": "GeocoderOp",
      "name": "centroid",
      "x": 0,
      "y": 195,
      "params": {
        "query": "Denver, CO"
      }
    },
    {
      "id": "charger-position",
      "op": "attribute",
      "name": "charger-position",
      "x": 700,
      "y": 142,
      "params": {
        "name": "charger_position",
        "expression": "[lng, lat]"
      }
    },
    {
      "id": "city-note",
      "op": "comment",
      "name": "city-note",
      "x": 0,
      "y": 107,
      "params": {
        "text": "This finds Denver, CO on the map. Click it and type another city into Query.",
        "width": 300,
        "height": 80
      }
    },
    {
      "id": "query-note",
      "op": "comment",
      "name": "query-note",
      "x": 340,
      "y": 80,
      "params": {
        "text": "This asks the Open Charge Map service for up to 1,000 charging stations around that city.",
        "width": 320,
        "height": 80
      }
    },
    {
      "id": "toggle-note",
      "op": "comment",
      "name": "toggle-note",
      "x": 1210,
      "y": 169,
      "params": {
        "text": "This picks which layer to show. Click it and set Index to 1 to see a heatmap.",
        "width": 290,
        "height": 80
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 1730,
      "y": 90,
      "params": {
        "text": "Try next:\n- Click charger-points and change Radius scale to resize the dots.\n- Click the diamond next to Zoom on auto-view, pick a later time in the Timeline, and change it again.\n- Press Export and pick Image (PNG) to save the map.",
        "width": 340,
        "height": 190
      }
    }
  ],
  "edges": [
    {
      "id": "charger-points.out->layer-toggle.in",
      "source": "charger-points",
      "sourcePort": "out",
      "target": "layer-toggle",
      "targetPort": "in",
      "index": 0
    },
    {
      "id": "charger-heatmap.out->layer-toggle.in.1",
      "source": "charger-heatmap",
      "sourcePort": "out",
      "target": "layer-toggle",
      "targetPort": "in",
      "index": 1
    },
    {
      "id": "layer-toggle.out->deck.layers",
      "source": "layer-toggle",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "charger-query.out->charger-bounds.par:data",
      "source": "charger-query",
      "sourcePort": "out",
      "target": "charger-bounds",
      "targetPort": "par:data"
    },
    {
      "id": "charger-bounds.longitude->auto-view.par:longitude",
      "source": "charger-bounds",
      "sourcePort": "longitude",
      "target": "auto-view",
      "targetPort": "par:longitude"
    },
    {
      "id": "charger-bounds.latitude->auto-view.par:latitude",
      "source": "charger-bounds",
      "sourcePort": "latitude",
      "target": "auto-view",
      "targetPort": "par:latitude"
    },
    {
      "id": "auto-view.viewState->deck.viewState",
      "source": "auto-view",
      "sourcePort": "viewState",
      "target": "deck",
      "targetPort": "viewState"
    },
    {
      "id": "charger-query.out->charger-position.in",
      "source": "charger-query",
      "sourcePort": "out",
      "target": "charger-position",
      "targetPort": "in"
    },
    {
      "id": "charger-position.out->charger-points.in",
      "source": "charger-position",
      "sourcePort": "out",
      "target": "charger-points",
      "targetPort": "in"
    },
    {
      "id": "charger-position.out->charger-heatmap.in",
      "source": "charger-position",
      "sourcePort": "out",
      "target": "charger-heatmap",
      "targetPort": "in"
    }
  ]
}
