{
  "version": 1,
  "name": "Table Editor Demo",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1136,
      "y": 19,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
        "projection": "mercator",
        "longitude": -97,
        "latitude": 39,
        "zoom": 5,
        "pitch": 0,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "cities-table",
      "op": "table",
      "name": "cities-table",
      "x": 0,
      "y": 9,
      "params": {
        "rows": "[\n  {\n    \"city\": \"New York City\",\n    \"position\": [\n      -74.006,\n      40.7128\n    ],\n    \"population\": 8336817,\n    \"color\": \"#ff5733\",\n    \"active\": true\n  },\n  {\n    \"city\": \"San Francisco\",\n    \"position\": [\n      -122.4194,\n      37.7749\n    ],\n    \"population\": 873965,\n    \"color\": \"#33ff57\",\n    \"active\": true\n  },\n  {\n    \"city\": \"Los Angeles\",\n    \"position\": [\n      -118.2437,\n      34.0522\n    ],\n    \"population\": 3979576,\n    \"color\": \"#3357ff\",\n    \"active\": true\n  },\n  {\n    \"city\": \"Chicago\",\n    \"position\": [\n      -87.6298,\n      41.8781\n    ],\n    \"population\": 2693976,\n    \"color\": \"#ff33f5\",\n    \"active\": false\n  },\n  {\n    \"city\": \"Seattle\",\n    \"position\": [\n      -122.3321,\n      47.6062\n    ],\n    \"population\": 753675,\n    \"color\": \"#f5ff33\",\n    \"active\": true\n  }\n]",
        "schema": "{\"columns\":[{\"name\":\"city\",\"type\":\"string\",\"defaultValue\":\"\"},{\"name\":\"position\",\"type\":\"point2d\",\"defaultValue\":[0,0],\"options\":{\"geocoder\":true}},{\"name\":\"population\",\"type\":\"number\",\"defaultValue\":0,\"options\":{\"min\":0,\"step\":1}},{\"name\":\"color\",\"type\":\"color\",\"defaultValue\":\"#3b82f6\"},{\"name\":\"active\",\"type\":\"boolean\",\"defaultValue\":true}]}"
      }
    },
    {
      "id": "cities-layer",
      "op": "scatter",
      "name": "cities-layer",
      "x": 882,
      "y": 0,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "city_position",
        "color": "(color) / 255.0",
        "radius": "city_radius",
        "radiusScale": 1,
        "radiusUnits": "meters"
      }
    },
    {
      "id": "labels-layer",
      "op": "text",
      "name": "labels-layer",
      "x": 882,
      "y": 110,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "city_position",
        "text": "city",
        "color": "",
        "textColor": [
          255,
          255,
          255
        ],
        "sizeBy": "",
        "size": 14,
        "sizeUnits": "pixels",
        "angle": 0,
        "offsetX": 0,
        "offsetY": -20,
        "anchor": "middle",
        "baseline": "center",
        "fontFamily": "Inter",
        "fontWeight": 600,
        "billboard": true,
        "outlineWidth": 0,
        "outlineColor": [
          0,
          0,
          0
        ],
        "background": false,
        "backgroundColor": [
          255,
          255,
          255
        ]
      }
    },
    {
      "id": "city-position",
      "op": "attribute",
      "name": "city-position",
      "x": 294,
      "y": 0,
      "params": {
        "name": "city_position",
        "expression": "[item(position, 0.0), item(position, 1.0)]"
      }
    },
    {
      "id": "city-radius",
      "op": "attribute",
      "name": "city-radius",
      "x": 588,
      "y": 0,
      "params": {
        "name": "city_radius",
        "expression": "sqrt(population) * 25"
      }
    }
  ],
  "edges": [
    {
      "id": "cities-layer.out->deck.layers",
      "source": "cities-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "labels-layer.out->deck.layers.10",
      "source": "labels-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 10
    },
    {
      "id": "cities-table.out->city-position.in",
      "source": "cities-table",
      "sourcePort": "out",
      "target": "city-position",
      "targetPort": "in"
    },
    {
      "id": "city-position.out->city-radius.in",
      "source": "city-position",
      "sourcePort": "out",
      "target": "city-radius",
      "targetPort": "in"
    },
    {
      "id": "city-radius.out->cities-layer.in",
      "source": "city-radius",
      "sourcePort": "out",
      "target": "cities-layer",
      "targetPort": "in"
    },
    {
      "id": "city-radius.out->labels-layer.in",
      "source": "city-radius",
      "sourcePort": "out",
      "target": "labels-layer",
      "targetPort": "in"
    }
  ]
}
