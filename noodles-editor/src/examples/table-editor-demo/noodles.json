{
  "version": 19,
  "name": "Table Editor Demo",
  "nodes": [
    {
      "id": "/cities-table",
      "type": "TableEditorOp",
      "position": {
        "x": 0,
        "y": 200
      },
      "data": {
        "inputs": {
          "schema": {
            "columns": [
              {
                "name": "city",
                "type": "string",
                "defaultValue": ""
              },
              {
                "name": "position",
                "type": "point2d",
                "defaultValue": [
                  0,
                  0
                ],
                "options": {
                  "geocoder": true
                }
              },
              {
                "name": "population",
                "type": "number",
                "defaultValue": 0,
                "options": {
                  "min": 0,
                  "step": 1
                }
              },
              {
                "name": "color",
                "type": "color",
                "defaultValue": "#3b82f6"
              },
              {
                "name": "active",
                "type": "boolean",
                "defaultValue": true
              }
            ]
          },
          "data": [
            {
              "city": "New York City",
              "position": [
                -74.006,
                40.7128
              ],
              "population": 8336817,
              "color": "#ff5733",
              "active": true
            },
            {
              "city": "San Francisco",
              "position": [
                -122.4194,
                37.7749
              ],
              "population": 873965,
              "color": "#33ff57",
              "active": true
            },
            {
              "city": "Los Angeles",
              "position": [
                -118.2437,
                34.0522
              ],
              "population": 3979576,
              "color": "#3357ff",
              "active": true
            },
            {
              "city": "Chicago",
              "position": [
                -87.6298,
                41.8781
              ],
              "population": 2693976,
              "color": "#ff33f5",
              "active": false
            },
            {
              "city": "Seattle",
              "position": [
                -122.3321,
                47.6062
              ],
              "population": 753675,
              "color": "#f5ff33",
              "active": true
            }
          ]
        },
        "locked": false
      }
    },
    {
      "id": "/city-position",
      "type": "AccessorOp",
      "position": {
        "x": 0,
        "y": 500
      },
      "data": {
        "inputs": {
          "expression": "d.position"
        },
        "locked": false
      }
    },
    {
      "id": "/city-radius",
      "type": "AccessorOp",
      "position": {
        "x": 0,
        "y": 650
      },
      "data": {
        "inputs": {
          "expression": "Math.sqrt(d.population) * 25"
        },
        "locked": false
      }
    },
    {
      "id": "/city-color",
      "type": "AccessorOp",
      "position": {
        "x": 0,
        "y": 800
      },
      "data": {
        "inputs": {
          "expression": "d.color"
        },
        "locked": false
      }
    },
    {
      "id": "/city-name",
      "type": "AccessorOp",
      "position": {
        "x": 0,
        "y": 950
      },
      "data": {
        "inputs": {
          "expression": "d.city"
        },
        "locked": false
      }
    },
    {
      "id": "/cities-layer",
      "type": "ScatterplotLayerOp",
      "position": {
        "x": 350,
        "y": 200
      },
      "data": {
        "inputs": {
          "radiusUnits": "meters",
          "getLineColor": "#ffffffff"
        },
        "locked": false
      }
    },
    {
      "id": "/labels-layer",
      "type": "TextLayerOp",
      "position": {
        "x": 350,
        "y": 600
      },
      "data": {
        "inputs": {
          "getSize": 14,
          "getColor": "#ffffffff",
          "getPixelOffset": {
            "x": 0,
            "y": -20
          },
          "fontWeight": 600
        },
        "locked": false
      }
    },
    {
      "id": "/basemap",
      "type": "MaplibreBasemapOp",
      "position": {
        "x": 350,
        "y": 950
      },
      "data": {
        "inputs": {
          "mapStyle": "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
          "viewState": {
            "latitude": 39,
            "longitude": -97,
            "zoom": 5,
            "pitch": 0,
            "bearing": 0
          }
        },
        "locked": false
      }
    },
    {
      "id": "/deck",
      "type": "DeckRendererOp",
      "position": {
        "x": 700,
        "y": 400
      },
      "data": {
        "inputs": {},
        "locked": false
      }
    },
    {
      "id": "/out",
      "type": "OutOp",
      "position": {
        "x": 1050,
        "y": 400
      },
      "data": {
        "inputs": {},
        "locked": false
      }
    }
  ],
  "edges": [
    {
      "id": "/cities-table.out.data->/cities-layer.par.data",
      "source": "/cities-table",
      "sourceHandle": "out.data",
      "target": "/cities-layer",
      "targetHandle": "par.data"
    },
    {
      "id": "/city-position.out.accessor->/cities-layer.par.getPosition",
      "source": "/city-position",
      "sourceHandle": "out.accessor",
      "target": "/cities-layer",
      "targetHandle": "par.getPosition"
    },
    {
      "id": "/city-radius.out.accessor->/cities-layer.par.getRadius",
      "source": "/city-radius",
      "sourceHandle": "out.accessor",
      "target": "/cities-layer",
      "targetHandle": "par.getRadius"
    },
    {
      "id": "/city-color.out.accessor->/cities-layer.par.getFillColor",
      "source": "/city-color",
      "sourceHandle": "out.accessor",
      "target": "/cities-layer",
      "targetHandle": "par.getFillColor"
    },
    {
      "id": "/cities-table.out.data->/labels-layer.par.data",
      "source": "/cities-table",
      "sourceHandle": "out.data",
      "target": "/labels-layer",
      "targetHandle": "par.data"
    },
    {
      "id": "/city-position.out.accessor->/labels-layer.par.getPosition",
      "source": "/city-position",
      "sourceHandle": "out.accessor",
      "target": "/labels-layer",
      "targetHandle": "par.getPosition"
    },
    {
      "id": "/city-name.out.accessor->/labels-layer.par.getText",
      "source": "/city-name",
      "sourceHandle": "out.accessor",
      "target": "/labels-layer",
      "targetHandle": "par.getText"
    },
    {
      "id": "/cities-layer.out.layer->/deck.par.layers",
      "source": "/cities-layer",
      "sourceHandle": "out.layer",
      "target": "/deck",
      "targetHandle": "par.layers"
    },
    {
      "id": "/labels-layer.out.layer->/deck.par.layers",
      "source": "/labels-layer",
      "sourceHandle": "out.layer",
      "target": "/deck",
      "targetHandle": "par.layers"
    },
    {
      "id": "/basemap.out.maplibre->/deck.par.basemap",
      "source": "/basemap",
      "sourceHandle": "out.maplibre",
      "target": "/deck",
      "targetHandle": "par.basemap"
    },
    {
      "id": "/deck.out.vis->/out.par.vis",
      "source": "/deck",
      "sourceHandle": "out.vis",
      "target": "/out",
      "targetHandle": "par.vis"
    }
  ],
  "editorSettings": {
    "layoutMode": "noodles-on-top",
    "showOverlay": true
  },
  "timeline": {
    "sheetsById": {
      "Noodles": {
        "staticOverrides": {
          "byObject": {}
        }
      }
    }
  }
}
