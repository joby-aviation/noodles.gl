{
  "version": 1,
  "name": "BitmapLayer \u2014 San Francisco Districts",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": -60,
      "y": 0,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
        "projection": "mercator",
        "longitude": -122.4,
        "latitude": 37.74,
        "zoom": 11,
        "pitch": 0,
        "bearing": 0,
        "display": "fixed",
        "width": 1280,
        "height": 720,
        "lod": 1,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.6,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "bitmap-layer",
      "op": "bitmap",
      "name": "bitmap-layer",
      "x": -460,
      "y": -140,
      "params": {
        "image": "@/sf-districts.png",
        "bounds": {
          "southwest": {
            "lng": -122.519,
            "lat": 37.7045
          },
          "northeast": {
            "lng": -122.355,
            "lat": 37.829
          }
        }
      }
    },
    {
      "id": "image-note",
      "op": "comment",
      "name": "image-note",
      "x": -460,
      "y": -260,
      "params": {
        "text": "This places a picture of San Francisco's districts on the map. Click it and lower Opacity to see the streets below.",
        "width": 331,
        "height": 90
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": -60,
      "y": 120,
      "params": {
        "text": "Try next:\n- Click bitmap-layer and change Desaturate to fade the colors.\n- Click the diamond next to Opacity, pick a later time in the Timeline, and change it again.\n- Press Export and pick Video (MP4) to save the fade.",
        "width": 340,
        "height": 170
      }
    }
  ],
  "edges": [
    {
      "id": "bitmap-layer.layer->deck.layers",
      "source": "bitmap-layer",
      "sourcePort": "layer",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    }
  ]
}
