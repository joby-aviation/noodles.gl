{
  "version": 1,
  "name": "NYC Taxis",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1130,
      "y": 139,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
        "projection": "mercator",
        "longitude": -73.98,
        "latitude": 40.74,
        "zoom": 12.09,
        "pitch": 56,
        "bearing": -15.25,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "data-source",
      "op": "file",
      "name": "data-source",
      "x": 0,
      "y": 184,
      "params": {
        "url": "@/data.csv",
        "format": "csv"
      }
    },
    {
      "id": "pickup",
      "op": "color",
      "name": "pickup",
      "x": 460,
      "y": 98,
      "params": {
        "color": [
          141,
          18,
          175
        ]
      }
    },
    {
      "id": "dropoff",
      "op": "color",
      "name": "dropoff",
      "x": 460,
      "y": 374,
      "params": {
        "color": [
          16,
          91,
          137
        ]
      }
    },
    {
      "id": "arc-layer",
      "op": "arc",
      "name": "arc-layer",
      "x": 790,
      "y": 219,
      "params": {
        "opacity": 1,
        "blend": "additive",
        "source": "pickup_position",
        "target": "dropoff_position",
        "sourceColor": "",
        "targetColor": "",
        "fromColor": {
          "ref": "pickup/color"
        },
        "toColor": {
          "ref": "dropoff/color"
        },
        "width": "",
        "widthScale": 4,
        "widthUnits": "meters",
        "height": 1
      }
    },
    {
      "id": "pickup-layer",
      "op": "scatter",
      "name": "pickup-layer",
      "x": 790,
      "y": 25,
      "params": {
        "opacity": 0.8,
        "blend": "additive",
        "position": "pickup_position",
        "color": "",
        "fillColor": {
          "ref": "pickup/color"
        },
        "radius": "",
        "radiusScale": 10,
        "radiusUnits": "pixels"
      }
    },
    {
      "id": "dropoff-layer",
      "op": "scatter",
      "name": "dropoff-layer",
      "x": 790,
      "y": 325,
      "params": {
        "opacity": 0.8,
        "blend": "additive",
        "position": "dropoff_position",
        "color": "",
        "fillColor": {
          "ref": "dropoff/color"
        },
        "radius": "",
        "radiusScale": 10,
        "radiusUnits": "pixels"
      }
    },
    {
      "id": "pickup-position",
      "op": "attribute",
      "name": "pickup-position",
      "x": 190,
      "y": 175,
      "params": {
        "name": "pickup_position",
        "expression": "[pickup_longitude, pickup_latitude]"
      }
    },
    {
      "id": "dropoff-position",
      "op": "attribute",
      "name": "dropoff-position",
      "x": 460,
      "y": 180,
      "params": {
        "name": "dropoff_position",
        "expression": "[dropoff_longitude, dropoff_latitude]"
      }
    },
    {
      "id": "data-note",
      "op": "comment",
      "name": "data-note",
      "x": 460,
      "y": 286,
      "params": {
        "text": "This loads the taxi trips CSV. Click it to see its columns.",
        "width": 265,
        "height": 80
      }
    },
    {
      "id": "color-note",
      "op": "comment",
      "name": "color-note",
      "x": 460,
      "y": 0,
      "params": {
        "text": "These two nodes set the pickup and drop-off colors. Click one to pick a new color.",
        "width": 290,
        "height": 90
      }
    },
    {
      "id": "arc-note",
      "op": "comment",
      "name": "arc-note",
      "x": 790,
      "y": 131,
      "params": {
        "text": "This layer draws an arc from each pickup to its drop-off. Click it and change Width scale.",
        "width": 300,
        "height": 80
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 1320,
      "y": 133,
      "params": {
        "text": "Try next:\n- Press the space bar to play the camera move on the Timeline.\n- Click arc-layer and change Height to raise or flatten the arcs.\n- Press Export and pick Video (MP4) to save the animation.",
        "width": 340,
        "height": 170
      }
    }
  ],
  "edges": [
    {
      "id": "arc-layer.out->deck.layers",
      "source": "arc-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "pickup-layer.out->deck.layers.10",
      "source": "pickup-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 10
    },
    {
      "id": "dropoff-layer.out->deck.layers.20",
      "source": "dropoff-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 20
    },
    {
      "id": "data-source.out->pickup-position.in",
      "source": "data-source",
      "sourcePort": "out",
      "target": "pickup-position",
      "targetPort": "in"
    },
    {
      "id": "pickup-position.out->dropoff-position.in",
      "source": "pickup-position",
      "sourcePort": "out",
      "target": "dropoff-position",
      "targetPort": "in"
    },
    {
      "id": "dropoff-position.out->arc-layer.in",
      "source": "dropoff-position",
      "sourcePort": "out",
      "target": "arc-layer",
      "targetPort": "in"
    },
    {
      "id": "dropoff-position.out->pickup-layer.in",
      "source": "dropoff-position",
      "sourcePort": "out",
      "target": "pickup-layer",
      "targetPort": "in"
    },
    {
      "id": "dropoff-position.out->dropoff-layer.in",
      "source": "dropoff-position",
      "sourcePort": "out",
      "target": "dropoff-layer",
      "targetPort": "in"
    }
  ],
  "timeline": {
    "length": 20,
    "fps": 30,
    "tracks": [
      {
        "target": "deck.bearing",
        "keyframes": [
          {
            "id": "kf_bearing_0",
            "time": 0,
            "value": -15.25,
            "interpolation": "bezier",
            "handles": {
              "left": [
                0.333,
                0.333
              ],
              "right": [
                0.667,
                0.667
              ]
            }
          },
          {
            "id": "kf_bearing_1",
            "time": 20,
            "value": 344.75,
            "interpolation": "hold"
          }
        ]
      }
    ]
  }
}
