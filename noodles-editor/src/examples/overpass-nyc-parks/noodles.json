{
  "version": 1,
  "name": "Overpass API NYC Parks",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 500,
      "y": -200,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
        "projection": "mercator",
        "longitude": -73.97,
        "latitude": 40.75,
        "zoom": 13.5,
        "pitch": 0,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "overpass-query",
      "op": "overpass",
      "name": "overpass-query",
      "x": -300,
      "y": -200,
      "params": {
        "query": "[out:json][timeout:25];\n(\n  way[\"leisure\"=\"park\"]({{bbox}});\n  relation[\"leisure\"=\"park\"]({{bbox}});\n);\nout geom;",
        "endpoint": "https://overpass.openstreetmap.fr/api/interpreter",
        "west": -74.05,
        "south": 40.68,
        "east": -73.9,
        "north": 40.82
      }
    },
    {
      "id": "overpass-query-rows",
      "op": "geojson",
      "name": "overpass-query-rows",
      "x": -300,
      "y": -40,
      "params": {
        "url": ""
      }
    },
    {
      "id": "geojson-layer",
      "op": "polygon",
      "name": "geojson-layer",
      "x": 200,
      "y": -200,
      "params": {
        "opacity": 0.7,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "fillColor": [
          16,
          185,
          129
        ],
        "lineColorChannel": "",
        "lineColor": [
          5,
          150,
          105
        ],
        "filled": true,
        "stroked": true,
        "lineWidthScale": 2,
        "lineWidthUnits": "meters",
        "lineWidthMinPixels": 0,
        "extruded": false,
        "elevation": "",
        "elevationScale": 1000
      }
    },
    {
      "id": "geojson-layer-lines",
      "op": "path",
      "name": "geojson-layer-lines",
      "x": 200,
      "y": -40,
      "params": {
        "opacity": 0.7,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "lineColor": [
          5,
          150,
          105
        ],
        "widthScale": 2,
        "widthUnits": "meters",
        "widthMinPixels": 0
      }
    },
    {
      "id": "geojson-layer-points",
      "op": "scatter",
      "name": "geojson-layer-points",
      "x": 200,
      "y": 120,
      "params": {
        "opacity": 0.7,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "fillColor": [
          16,
          185,
          129
        ],
        "radius": "",
        "radiusScale": 1,
        "radiusUnits": "meters"
      }
    },
    {
      "id": "/query-note",
      "type": "CommentOp",
      "position": {
        "x": -300,
        "y": -340
      },
      "data": {
        "inputs": {
          "text": "This asks OpenStreetMap for every park inside the box set by bounds. Change both park entries in query to playground to map playgrounds."
        },
        "locked": false
      },
      "width": 330,
      "height": 110
    },
    {
      "id": "/layer-note",
      "type": "CommentOp",
      "position": {
        "x": 200,
        "y": 130
      },
      "data": {
        "inputs": {
          "text": "This layer fills each park in green. Click it and pick a new getFillColor."
        },
        "locked": false
      },
      "width": 300,
      "height": 80
    },
    {
      "id": "/try-next-note",
      "type": "CommentOp",
      "position": {
        "x": 800,
        "y": -90
      },
      "data": {
        "inputs": {
          "text": "Try next:\n- Click maplibre-basemap and change zoom under viewState to see all the parks.\n- Click the diamond next to opacity on geojson-layer, pick a later time in the Timeline, and change it again.\n- Press Export and pick Image (PNG) to save the map."
        },
        "locked": false
      },
      "width": 340,
      "height": 190
    }
  ],
  "edges": [
    {
      "id": "overpass-query.out->overpass-query-rows.in",
      "source": "overpass-query",
      "sourcePort": "out",
      "target": "overpass-query-rows",
      "targetPort": "in"
    },
    {
      "id": "geojson-layer.out->deck.layers",
      "source": "geojson-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "geojson-layer-lines.out->deck.layers.1",
      "source": "geojson-layer-lines",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 1
    },
    {
      "id": "geojson-layer-points.out->deck.layers.2",
      "source": "geojson-layer-points",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 2
    },
    {
      "id": "overpass-query-rows.features->geojson-layer.in",
      "source": "overpass-query-rows",
      "sourcePort": "features",
      "target": "geojson-layer",
      "targetPort": "in"
    },
    {
      "id": "overpass-query-rows.features->geojson-layer-lines.in",
      "source": "overpass-query-rows",
      "sourcePort": "features",
      "target": "geojson-layer-lines",
      "targetPort": "in"
    },
    {
      "id": "overpass-query-rows.features->geojson-layer-points.in",
      "source": "overpass-query-rows",
      "sourcePort": "features",
      "target": "geojson-layer-points",
      "targetPort": "in"
    }
  ]
}
