{
  "version": 1,
  "name": "Overpass API NYC Parks",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 854,
      "y": 200,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
        "projection": "mercator",
        "longitude": -73.97,
        "latitude": 40.75,
        "zoom": 13.5,
        "pitch": 0,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "overpass-query",
      "op": "overpass",
      "name": "overpass-query",
      "x": 0,
      "y": 144,
      "params": {
        "query": "[out:json][timeout:25];\n(\n  way[\"leisure\"=\"park\"]({{bbox}});\n  relation[\"leisure\"=\"park\"]({{bbox}});\n);\nout geom;",
        "endpoint": "https://overpass.openstreetmap.fr/api/interpreter",
        "west": -74.05,
        "south": 40.68,
        "east": -73.9,
        "north": 40.82
      }
    },
    {
      "id": "overpass-query-rows",
      "op": "geojson",
      "name": "overpass-query-rows",
      "x": 284,
      "y": 99,
      "params": {
        "url": ""
      }
    },
    {
      "id": "geojson-layer",
      "op": "polygon",
      "name": "geojson-layer",
      "x": 560,
      "y": 126,
      "params": {
        "opacity": 0.7,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "fillColor": [
          16,
          185,
          129
        ],
        "lineColorChannel": "",
        "lineColor": [
          5,
          150,
          105
        ],
        "filled": true,
        "stroked": true,
        "lineWidthScale": 2,
        "lineWidthUnits": "meters",
        "lineWidthMinPixels": 0,
        "extruded": false,
        "elevation": "",
        "elevationScale": 1000
      }
    },
    {
      "id": "geojson-layer-lines",
      "op": "path",
      "name": "geojson-layer-lines",
      "x": 560,
      "y": 236,
      "params": {
        "opacity": 0.7,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "lineColor": [
          5,
          150,
          105
        ],
        "widthScale": 2,
        "widthUnits": "meters",
        "widthMinPixels": 0
      }
    },
    {
      "id": "geojson-layer-points",
      "op": "scatter",
      "name": "geojson-layer-points",
      "x": 560,
      "y": 346,
      "params": {
        "opacity": 0.7,
        "blend": "normal",
        "position": "geom",
        "color": "",
        "fillColor": [
          16,
          185,
          129
        ],
        "radius": "",
        "radiusScale": 1,
        "radiusUnits": "meters"
      }
    },
    {
      "id": "query-note",
      "op": "comment",
      "name": "query-note",
      "x": 0,
      "y": 0,
      "params": {
        "text": "This asks OpenStreetMap for every park inside the box set by West, South, East and North. Change both park entries in Query to playground to map playgrounds.",
        "width": 220,
        "height": 136
      }
    },
    {
      "id": "layer-note",
      "op": "comment",
      "name": "layer-note",
      "x": 560,
      "y": 41,
      "params": {
        "text": "This layer fills each park in green. Click it and pick a new Fill color.",
        "width": 230,
        "height": 77
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 1068,
      "y": 200,
      "params": {
        "text": "Try next:\n- Click deck and change Zoom to see all the parks.\n- Click the diamond next to Opacity on geojson-layer, pick a later time in the Timeline, and change it again.\n- Press Export and pick Image (PNG) to save the map.",
        "width": 340,
        "height": 175
      }
    }
  ],
  "edges": [
    {
      "id": "overpass-query.out->overpass-query-rows.in",
      "source": "overpass-query",
      "sourcePort": "out",
      "target": "overpass-query-rows",
      "targetPort": "in"
    },
    {
      "id": "geojson-layer.out->deck.layers",
      "source": "geojson-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "geojson-layer-lines.out->deck.layers.1",
      "source": "geojson-layer-lines",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 1
    },
    {
      "id": "geojson-layer-points.out->deck.layers.2",
      "source": "geojson-layer-points",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 2
    },
    {
      "id": "overpass-query-rows.features->geojson-layer.in",
      "source": "overpass-query-rows",
      "sourcePort": "features",
      "target": "geojson-layer",
      "targetPort": "in"
    },
    {
      "id": "overpass-query-rows.features->geojson-layer-lines.in",
      "source": "overpass-query-rows",
      "sourcePort": "features",
      "target": "geojson-layer-lines",
      "targetPort": "in"
    },
    {
      "id": "overpass-query-rows.features->geojson-layer-points.in",
      "source": "overpass-query-rows",
      "sourcePort": "features",
      "target": "geojson-layer-points",
      "targetPort": "in"
    }
  ]
}
