{
  "version": 1,
  "name": "UK Commute Patterns",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1156,
      "y": 233,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
        "projection": "mercator",
        "longitude": -2.69,
        "latitude": 52.25,
        "zoom": 7.56,
        "pitch": 49.18,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "data-source",
      "op": "file",
      "name": "data-source",
      "x": 0,
      "y": 180,
      "params": {
        "url": "https://raw.githubusercontent.com/keplergl/kepler.gl-data/master/ukcommute/data.csv",
        "format": "csv"
      }
    },
    {
      "id": "source-color",
      "op": "color",
      "name": "source-color",
      "x": 578,
      "y": 85,
      "params": {
        "color": [
          246,
          154,
          0
        ]
      }
    },
    {
      "id": "target-color",
      "op": "color",
      "name": "target-color",
      "x": 578,
      "y": 171,
      "params": {
        "color": [
          149,
          12,
          105
        ]
      }
    },
    {
      "id": "arc-layer",
      "op": "arc",
      "name": "arc-layer",
      "x": 872,
      "y": 159,
      "params": {
        "opacity": 0.3,
        "blend": "additive",
        "source": "home_position",
        "target": "work_position",
        "sourceColor": "",
        "targetColor": "",
        "fromColor": {
          "ref": "source-color/color"
        },
        "toColor": {
          "ref": "target-color/color"
        },
        "width": "",
        "widthScale": 80,
        "widthUnits": "meters",
        "height": 0.7
      }
    },
    {
      "id": "residence-layer",
      "op": "scatter",
      "name": "residence-layer",
      "x": 872,
      "y": 269,
      "params": {
        "opacity": 0.4,
        "blend": "additive",
        "position": "home_position",
        "color": "",
        "fillColor": {
          "ref": "source-color/color"
        },
        "radius": "",
        "radiusScale": 3,
        "radiusUnits": "pixels"
      }
    },
    {
      "id": "workplace-layer",
      "op": "scatter",
      "name": "workplace-layer",
      "x": 872,
      "y": 379,
      "params": {
        "opacity": 0.3,
        "blend": "additive",
        "position": "work_position",
        "color": "",
        "fillColor": {
          "ref": "target-color/color"
        },
        "radius": "",
        "radiusScale": 3,
        "radiusUnits": "pixels"
      }
    },
    {
      "id": "home-position",
      "op": "attribute",
      "name": "home-position",
      "x": 284,
      "y": 171,
      "params": {
        "name": "home_position",
        "expression": "[residence_lng, residence_lat]"
      }
    },
    {
      "id": "work-position",
      "op": "attribute",
      "name": "work-position",
      "x": 578,
      "y": 257,
      "params": {
        "name": "work_position",
        "expression": "[workplace_lng, workplace_lat]"
      }
    },
    {
      "id": "data-note",
      "op": "comment",
      "name": "data-note",
      "x": 0,
      "y": 95,
      "params": {
        "text": "This loads UK commute flows: where people live and where they work.",
        "width": 220,
        "height": 77
      }
    },
    {
      "id": "color-note",
      "op": "comment",
      "name": "color-note",
      "x": 578,
      "y": 0,
      "params": {
        "text": "These two nodes set the home and work colors. Click one to pick a new color.",
        "width": 230,
        "height": 77
      }
    },
    {
      "id": "arc-note",
      "op": "comment",
      "name": "arc-note",
      "x": 872,
      "y": 55,
      "params": {
        "text": "Each arc links a home (orange) to a workplace (purple). Click it and change Height.",
        "width": 220,
        "height": 96
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 1370,
      "y": 233,
      "params": {
        "text": "Try next:\n- Click residence-layer and change Radius scale to resize the home dots.\n- Click the diamond next to Bearing on deck, pick a later time in the Timeline, and change it again.\n- Press Export and pick Video (MP4) to save the animation.",
        "width": 340,
        "height": 155
      }
    }
  ],
  "edges": [
    {
      "id": "arc-layer.out->deck.layers",
      "source": "arc-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "residence-layer.out->deck.layers.10",
      "source": "residence-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 10
    },
    {
      "id": "workplace-layer.out->deck.layers.20",
      "source": "workplace-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 20
    },
    {
      "id": "data-source.out->home-position.in",
      "source": "data-source",
      "sourcePort": "out",
      "target": "home-position",
      "targetPort": "in"
    },
    {
      "id": "home-position.out->work-position.in",
      "source": "home-position",
      "sourcePort": "out",
      "target": "work-position",
      "targetPort": "in"
    },
    {
      "id": "work-position.out->arc-layer.in",
      "source": "work-position",
      "sourcePort": "out",
      "target": "arc-layer",
      "targetPort": "in"
    },
    {
      "id": "work-position.out->residence-layer.in",
      "source": "work-position",
      "sourcePort": "out",
      "target": "residence-layer",
      "targetPort": "in"
    },
    {
      "id": "work-position.out->workplace-layer.in",
      "source": "work-position",
      "sourcePort": "out",
      "target": "workplace-layer",
      "targetPort": "in"
    }
  ]
}
