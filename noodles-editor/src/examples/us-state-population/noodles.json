{
  "version": 1,
  "name": "US State Population",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1000,
      "y": 0,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/positron-nolabels-gl-style/style.json",
        "projection": "mercator",
        "longitude": -96,
        "latitude": 38,
        "zoom": 4.5,
        "pitch": 0,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "state-data",
      "op": "file",
      "name": "state-data",
      "x": -1000,
      "y": 0,
      "params": {
        "url": "@/data.csv",
        "format": "csv"
      }
    },
    {
      "id": "population-choropleth",
      "op": "choropleth",
      "name": "population-choropleth",
      "x": -500,
      "y": -600,
      "params": {
        "opacity": 0.85,
        "geography": "us-states",
        "joinKey": "state",
        "geoKey": "abbrev",
        "valueColumn": "population",
        "colorScheme": "blues",
        "stroked": true,
        "lineColor": [
          255,
          255,
          255
        ],
        "lineWidth": 1
      }
    },
    {
      "id": "state-join",
      "op": "choropleth-join",
      "name": "state-join",
      "x": -500,
      "y": 200,
      "params": {
        "geography": "us-states",
        "joinKey": "state",
        "geoKey": "abbrev"
      }
    },
    {
      "id": "state-centroids",
      "op": "code",
      "name": "state-centroids",
      "x": 0,
      "y": 200,
      "params": {
        "code": "// One label point per state, keeping the joined properties\nreturn {\n  type: 'FeatureCollection',\n  features: d.features.map(f => turf.centroid(f, { properties: f.properties })),\n}"
      }
    },
    {
      "id": "labels",
      "op": "text",
      "name": "labels",
      "x": 500,
      "y": 600,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "geom",
        "text": "label",
        "size": 16,
        "textColor": [
          26,
          26,
          26
        ],
        "offsetY": 0
      }
    },
    {
      "id": "label-text",
      "op": "sql",
      "name": "label-text",
      "x": 260,
      "y": 200,
      "params": {
        "query": "SELECT *, state || ' ' || printf('%.1f', population / 1e6) || 'M' AS label FROM {{input0}}"
      }
    },
    {
      "id": "/data-note",
      "type": "CommentOp",
      "position": {
        "x": -1000,
        "y": -110
      },
      "data": {
        "inputs": {
          "text": "This loads the 2020 population of each US state from a CSV file."
        },
        "locked": false
      },
      "width": 300,
      "height": 80
    },
    {
      "id": "/choropleth-note",
      "type": "CommentOp",
      "position": {
        "x": -500,
        "y": -720
      },
      "data": {
        "inputs": {
          "text": "This colors each state by its population. Click it and pick a different colorScheme."
        },
        "locked": false
      },
      "width": 340,
      "height": 80
    },
    {
      "id": "/labels-note",
      "type": "CommentOp",
      "position": {
        "x": 500,
        "y": 640
      },
      "data": {
        "inputs": {
          "text": "This writes each state's short name and population on the map, like CA 39.5M."
        },
        "locked": false
      },
      "width": 300,
      "height": 80
    },
    {
      "id": "/try-next-note",
      "type": "CommentOp",
      "position": {
        "x": 1000,
        "y": 180
      },
      "data": {
        "inputs": {
          "text": "Try next:\n- Click labels and change getTextSize to resize the labels.\n- Click the diamond next to opacity on population-choropleth, pick a later time in the Timeline, and change it again.\n- Press Export and pick Image (PNG) to save the map."
        },
        "locked": false
      },
      "width": 340,
      "height": 190
    }
  ],
  "edges": [
    {
      "id": "state-data.out->population-choropleth.in",
      "source": "state-data",
      "sourcePort": "out",
      "target": "population-choropleth",
      "targetPort": "in"
    },
    {
      "id": "state-data.out->state-join.in",
      "source": "state-data",
      "sourcePort": "out",
      "target": "state-join",
      "targetPort": "in"
    },
    {
      "id": "state-join.out->state-centroids.in",
      "source": "state-join",
      "sourcePort": "out",
      "target": "state-centroids",
      "targetPort": "in"
    },
    {
      "id": "state-centroids.out->label-text.in0",
      "source": "state-centroids",
      "sourcePort": "out",
      "target": "label-text",
      "targetPort": "in0"
    },
    {
      "id": "label-text.out->labels.in",
      "source": "label-text",
      "sourcePort": "out",
      "target": "labels",
      "targetPort": "in"
    },
    {
      "id": "population-choropleth.out->deck.layers.0",
      "source": "population-choropleth",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "labels.out->deck.layers.1",
      "source": "labels",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 1
    }
  ]
}
