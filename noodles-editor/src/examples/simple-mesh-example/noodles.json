{
  "version": 1,
  "name": "Simple Mesh Layer BART Stations",
  "nodes": [
    {
      "id": "deck",
      "op": "deck",
      "name": "deck",
      "x": 1509,
      "y": 88,
      "params": {
        "mapStyle": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
        "projection": "mercator",
        "longitude": -122.4,
        "latitude": 37.74,
        "zoom": 13,
        "pitch": 30,
        "bearing": 0,
        "display": "fixed",
        "width": 1920,
        "height": 1080,
        "lod": 2,
        "scaleMode": "fit",
        "waitForData": true,
        "codec": "avc",
        "bitrateMbps": 10,
        "bitrateMode": "constant",
        "scaleControl": 0.3,
        "framerate": 30,
        "captureDelay": 50,
        "rendersDirectory": "renders"
      }
    },
    {
      "id": "data-source",
      "op": "file",
      "name": "data-source",
      "x": 0,
      "y": 133,
      "params": {
        "url": "https://raw.githubusercontent.com/visgl/deck.gl-data/master/website/bart-stations.json",
        "format": "json"
      }
    },
    {
      "id": "mesh-layer",
      "op": "mesh",
      "name": "mesh-layer",
      "x": 1129,
      "y": 124,
      "params": {
        "opacity": 1,
        "blend": "normal",
        "position": "position",
        "color": "(color) / 255.0",
        "orientation": "orientation",
        "scale": "",
        "translation": "",
        "mesh": "https://raw.githubusercontent.com/visgl/deck.gl-data/master/website/humanoid_quad.obj",
        "sizeScale": 30,
        "wireframe": false
      }
    },
    {
      "id": "position",
      "op": "attribute",
      "name": "position",
      "x": 340,
      "y": 80,
      "params": {
        "name": "position",
        "expression": "[item(coordinates, 0.0), item(coordinates, 1.0)]"
      }
    },
    {
      "id": "color",
      "op": "attribute",
      "name": "color",
      "x": 610,
      "y": 80,
      "params": {
        "name": "color",
        "expression": "([sqrt(exits), 140, 0])"
      }
    },
    {
      "id": "orientation",
      "op": "attribute",
      "name": "orientation",
      "x": 859,
      "y": 80,
      "params": {
        "name": "orientation",
        "expression": "[0, random() * 180, 0]"
      }
    },
    {
      "id": "data-note",
      "op": "comment",
      "name": "data-note",
      "x": 0,
      "y": 45,
      "params": {
        "text": "This loads BART train stations, with how many riders exit at each one.",
        "width": 300,
        "height": 80
      }
    },
    {
      "id": "mesh-note",
      "op": "comment",
      "name": "mesh-note",
      "x": 1129,
      "y": 36,
      "params": {
        "text": "This puts a small 3D figure on each station. Click it and change Size scale to resize them.",
        "width": 340,
        "height": 80
      }
    },
    {
      "id": "color-note",
      "op": "comment",
      "name": "color-note",
      "x": 1509,
      "y": 0,
      "params": {
        "text": "color sets each figure by its riders: busy stations are orange and quiet ones are green.",
        "width": 330,
        "height": 80
      }
    },
    {
      "id": "try-next-note",
      "op": "comment",
      "name": "try-next-note",
      "x": 1879,
      "y": 48,
      "params": {
        "text": "Try next:\n- Click mesh-layer and turn on Wireframe.\n- Click the diamond next to Size scale, pick a later time in the Timeline, and change it again.\n- Press Export and pick Video (MP4) to save the animation.",
        "width": 340,
        "height": 150
      }
    }
  ],
  "edges": [
    {
      "id": "mesh-layer.out->deck.layers",
      "source": "mesh-layer",
      "sourcePort": "out",
      "target": "deck",
      "targetPort": "layers",
      "index": 0
    },
    {
      "id": "data-source.out->position.in",
      "source": "data-source",
      "sourcePort": "out",
      "target": "position",
      "targetPort": "in"
    },
    {
      "id": "position.out->color.in",
      "source": "position",
      "sourcePort": "out",
      "target": "color",
      "targetPort": "in"
    },
    {
      "id": "color.out->orientation.in",
      "source": "color",
      "sourcePort": "out",
      "target": "orientation",
      "targetPort": "in"
    },
    {
      "id": "orientation.out->mesh-layer.in",
      "source": "orientation",
      "sourcePort": "out",
      "target": "mesh-layer",
      "targetPort": "in"
    }
  ]
}
