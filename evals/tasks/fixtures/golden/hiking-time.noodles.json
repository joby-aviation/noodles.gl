    {
      "id": "/hiking-time",
      "type": "CodeOp",
      "position": {
        "x": 950,
        "y": -800
      },
      "data": {
        "inputs": {
          "code": [
            "const baseSpeed = op('/base-speed').out.val // km/h",
            "const elevGain = op('/elev-gain').out.val // meters",
            "const elevDescent = op('/elev-descent').out.val // meters",
            "",
            "const distKm = d // km",
            "const terrainFactor = data[1]",
            "",
            "// Horizontal time",
            "const horizontalTime = (distKm * terrainFactor / baseSpeed) * 60",
            "",
            "// Ascent penalty: +1 min per 10m gain",
            "const ascentTime = elevGain / 10",
            "",
            "// Descent correction (Langmuir)",
            "const distM = distKm * 1000",
            "const slopeDeg = Math.atan2(elevDescent, distM) * (180 / Math.PI)",
            "let descentCorrection = 0",
            "if (slopeDeg >= 5 && slopeDeg <= 12) {",
            "  descentCorrection = -(elevDescent / 300) * 10",
            "} else if (slopeDeg > 12) {",
            "  descentCorrection = (elevDescent / 300) * 10",
            "}",
            "",
            "const totalTime = horizontalTime + ascentTime + descentCorrection",
            "",
            "return {",
            "  distKm,",
            "  terrainFactor,",
            "  horizontalTime,",
            "  ascentTime,",
            "  slopeDeg,",
            "  descentCorrection,",
            "  totalTime",
            "}"
          ]
        },
        "locked": false
      }
    },
