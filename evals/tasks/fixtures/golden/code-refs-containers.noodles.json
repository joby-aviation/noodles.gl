      "data": {
        "inputs": {
          "code": "const rows = op('/quake-data').out.data ?? []\nconst minMagnitude = op('/min-magnitude').par.val\nreturn rows\n  .filter(d => d.Magnitude >= minMagnitude)\n  .map(d => ({ ...d, energy: Math.pow(10, 1.5 * d.Magnitude) }))"
        },
        "locked": false
      }
    },
