{
  "version": 18,
  "nodes": [
    {
      "id": "/flights-export",
      "type": "FileOp",
      "data": {
        "inputs": {
          "format": "csv",
          "url": "@/flights.csv"
        },
        "locked": false
      },
      "position": {
        "x": -500,
        "y": 0
      }
    },
    {
      "id": "/last-week-ny-helicopters",
      "type": "CodeOp",
      "data": {
        "inputs": {
          "code": [
            "// Last week = Mon 2026-10-12 to Sun 2026-10-18 (the export was pulled Mon 10-19)",
            "const NY = new Set(['NYHP', 'JFK', 'EWR', 'LGA', 'HPN', 'EEND'])",
            "// FileOp's autoType turns ISO timestamps into Dates",
            "const day = r => new Date(r.timestamp).toISOString().slice(0, 10)",
            "const rows = d.filter(r =>",
            "  r.aircraft === 'helicopter' &&",
            "  day(r) >= '2026-10-12' && day(r) <= '2026-10-18' &&",
            "  (NY.has(r.origin) || NY.has(r.destination))",
            ")",
            "const byFlight = d3.group(rows, r => r.flight_id)",
            "return [...byFlight].map(([flight_id, samples]) => ({",
            "  flight_id,",
            "  route: `${samples[0].origin} to ${samples[0].destination}`,",
            "  path: samples.map(s => [Number(s.lng), Number(s.lat)])",
            "}))"
          ]
        },
        "locked": false
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "/route-layer",
      "type": "PathLayerOp",
      "data": {
        "inputs": {
          "widthUnits": "pixels",
          "getWidth": 3,
          "getColor": "#ffb000"
        },
        "locked": false
      },
      "position": {
