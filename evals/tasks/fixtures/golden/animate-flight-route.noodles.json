      "type": "CodeOp",
      "data": {
        "inputs": {
          "code": [
            "// FileOp's autoType turns ISO timestamps into Dates",
            "const samples = d.filter(r => r.flight_id === 'FLT-1018')",
            "const seconds = s => new Date(s.timestamp).getTime() / 1000",
            "const t0 = seconds(samples[0])",
            "return [{",
            "  flight_id: 'FLT-1018',",
            "  path: samples.map(s => [Number(s.lng), Number(s.lat), Number(s.alt_m)]),",
            "  timestamps: samples.map(s => seconds(s) - t0)",
            "}]"
