{
  "version": 14,
  "name": "California Earthquakes by Magnitude",
  "viewport": {
    "x": 600,
    "y": 300,
    "zoom": 0.8
  },
  "nodes": [
    {
      "id": "/file",
      "type": "FileOp",
      "position": { "x": -800, "y": 0 },
      "data": {
        "inputs": {
          "url": "@/data.csv"
        },
        "locked": false
      }
    },
    {
      "id": "/position",
      "type": "AccessorOp",
      "position": { "x": -500, "y": 200 },
      "data": {
        "inputs": {
          "expression": "[d.Longitude, d.Latitude]"
        },
        "locked": false
      }
    },
    {
      "id": "/radius",
      "type": "AccessorOp",
      "position": { "x": -500, "y": 350 },
      "data": {
        "inputs": {
          "expression": "Math.pow(2, d.Magnitude) * 500"
        },
        "locked": false
      }
    },
    {
      "id": "/layer",
      "type": "ScatterplotLayerOp",
      "position": { "x": -150, "y": 0 },
      "data": {
        "inputs": {
          "getFillColor": "#ff4400cc",
          "getLineColor": "#ff000000",
          "opacity": 0.7,
          "radiusUnits": "meters",
          "radiusMinPixels": 2
        },
        "locked": false
      }
    },
    {
      "id": "/viewstate",
      "type": "MapViewStateOp",
      "position": { "x": -150, "y": 250 },
      "data": {
        "inputs": {
          "longitude": -119.5,
          "latitude": 37.0,
          "zoom": 5
        },
        "locked": false
      }
    },
    {
      "id": "/basemap",
      "type": "MaplibreBasemapOp",
      "position": { "x": 200, "y": 250 },
      "data": {
        "inputs": {},
        "locked": false
      }
    },
    {
      "id": "/deck",
      "type": "DeckRendererOp",
      "position": { "x": 200, "y": 0 },
      "data": {
        "inputs": {},
        "locked": false
      }
    },
    {
      "id": "/out",
      "type": "OutOp",
      "position": { "x": 500, "y": 0 },
      "data": {
        "inputs": {},
        "locked": false
      }
    }
  ],
  "edges": [
    {
      "id": "/file.out.data->/layer.par.data",
      "source": "/file",
      "sourceHandle": "out.data",
      "target": "/layer",
      "targetHandle": "par.data"
    },
    {
      "id": "/position.out.accessor->/layer.par.getPosition",
      "source": "/position",
      "sourceHandle": "out.accessor",
      "target": "/layer",
      "targetHandle": "par.getPosition"
    },
    {
      "id": "/radius.out.accessor->/layer.par.getRadius",
      "source": "/radius",
      "sourceHandle": "out.accessor",
      "target": "/layer",
      "targetHandle": "par.getRadius"
    },
    {
      "id": "/layer.out.layer->/deck.par.layers",
      "source": "/layer",
      "sourceHandle": "out.layer",
      "target": "/deck",
      "targetHandle": "par.layers"
    },
    {
      "id": "/viewstate.out.viewState->/basemap.par.viewState",
      "source": "/viewstate",
      "sourceHandle": "out.viewState",
      "target": "/basemap",
      "targetHandle": "par.viewState"
    },
    {
      "id": "/basemap.out.maplibre->/deck.par.basemap",
      "source": "/basemap",
      "sourceHandle": "out.maplibre",
      "target": "/deck",
      "targetHandle": "par.basemap"
    },
    {
      "id": "/deck.out.vis->/out.par.vis",
      "source": "/deck",
      "sourceHandle": "out.vis",
      "target": "/out",
      "targetHandle": "par.vis"
    }
  ]
}
