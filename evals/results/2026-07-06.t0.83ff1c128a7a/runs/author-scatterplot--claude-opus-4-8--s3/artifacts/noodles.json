{
  "version": 14,
  "name": "Quake Magnitude Viz",
  "editorSettings": {
    "layoutMode": "noodles-on-top",
    "showOverlay": true
  },
  "nodes": [
    {
      "id": "/data-source",
      "type": "FileOp",
      "data": {
        "inputs": {
          "format": "csv",
          "url": "@/data.csv"
        },
        "locked": false
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "/position",
      "type": "AccessorOp",
      "data": {
        "inputs": {
          "expression": "[d.Longitude, d.Latitude]"
        },
        "locked": false
      },
      "position": {
        "x": 0,
        "y": 180
      }
    },
    {
      "id": "/radius",
      "type": "AccessorOp",
      "data": {
        "inputs": {
          "expression": "Math.pow(d.Magnitude, 2) * 300"
        },
        "locked": false
      },
      "position": {
        "x": 0,
        "y": 360
      }
    },
    {
      "id": "/scatterplot-layer",
      "type": "ScatterplotLayerOp",
      "data": {
        "inputs": {
          "radiusUnits": "meters",
          "opacity": 0.7,
          "stroked": false,
          "getFillColor": "#ff5a3cff"
        },
        "locked": false
      },
      "position": {
        "x": 400,
        "y": 120
      }
    },
    {
      "id": "/maplibre-basemap",
      "type": "MaplibreBasemapOp",
      "data": {
        "inputs": {
          "mapStyle": "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
          "viewState": {
            "latitude": 37.735,
            "longitude": -120.89,
            "zoom": 6,
            "pitch": 0,
            "bearing": 0
          }
        },
        "locked": false
      },
      "position": {
        "x": 400,
        "y": 400
      }
    },
    {
      "id": "/deck",
      "type": "DeckRendererOp",
      "data": {
        "inputs": {},
        "locked": false
      },
      "position": {
        "x": 800,
        "y": 200
      }
    },
    {
      "id": "/out",
      "type": "OutOp",
      "data": {
        "inputs": {},
        "locked": false
      },
      "position": {
        "x": 1100,
        "y": 200
      }
    }
  ],
  "edges": [
    {
      "id": "/data-source.out.data->/scatterplot-layer.par.data",
      "source": "/data-source",
      "target": "/scatterplot-layer",
      "sourceHandle": "out.data",
      "targetHandle": "par.data"
    },
    {
      "id": "/position.out.accessor->/scatterplot-layer.par.getPosition",
      "source": "/position",
      "target": "/scatterplot-layer",
      "sourceHandle": "out.accessor",
      "targetHandle": "par.getPosition"
    },
    {
      "id": "/radius.out.accessor->/scatterplot-layer.par.getRadius",
      "source": "/radius",
      "target": "/scatterplot-layer",
      "sourceHandle": "out.accessor",
      "targetHandle": "par.getRadius"
    },
    {
      "id": "/scatterplot-layer.out.layer->/deck.par.layers",
      "source": "/scatterplot-layer",
      "target": "/deck",
      "sourceHandle": "out.layer",
      "targetHandle": "par.layers"
    },
    {
      "id": "/maplibre-basemap.out.maplibre->/deck.par.basemap",
      "source": "/maplibre-basemap",
      "target": "/deck",
      "sourceHandle": "out.maplibre",
      "targetHandle": "par.basemap"
    },
    {
      "id": "/deck.out.vis->/out.par.vis",
      "source": "/deck",
      "target": "/out",
      "sourceHandle": "out.vis",
      "targetHandle": "par.vis"
    }
  ],
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 0.7
  },
  "timeline": {
    "sheetsById": {
      "Noodles": {
        "staticOverrides": {
          "byObject": {}
        }
      }
    },
    "definitionVersion": "0.4.0",
    "revisionHistory": []
  }
}
