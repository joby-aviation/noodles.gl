{
  "version": 14,
  "name": "California Earthquake Magnitude",
  "viewport": {
    "x": 400,
    "y": 300,
    "zoom": 0.8
  },
  "editorSettings": {
    "layoutMode": "noodles-on-top",
    "showOverlay": true
  },
  "nodes": [
    {
      "id": "/file",
      "type": "FileOp",
      "position": { "x": -900, "y": 0 },
      "data": {
        "inputs": {
          "url": "@/data.csv"
        },
        "locked": false
      }
    },
    {
      "id": "/position",
      "type": "AccessorOp",
      "position": { "x": -550, "y": 150 },
      "data": {
        "inputs": {
          "expression": "[d.Longitude, d.Latitude]"
        },
        "locked": false
      }
    },
    {
      "id": "/radius",
      "type": "AccessorOp",
      "position": { "x": -550, "y": -100 },
      "data": {
        "inputs": {
          "expression": "Math.pow(2, d.Magnitude) * 100"
        },
        "locked": false
      }
    },
    {
      "id": "/scatter",
      "type": "ScatterplotLayerOp",
      "position": { "x": -200, "y": 0 },
      "data": {
        "inputs": {
          "getFillColor": "#ff4400cc",
          "getLineColor": "#ff000000",
          "radiusUnits": "meters",
          "opacity": 0.6
        },
        "locked": false
      }
    },
    {
      "id": "/viewstate",
      "type": "MapViewStateOp",
      "position": { "x": 150, "y": -200 },
      "data": {
        "inputs": {
          "longitude": -119,
          "latitude": 37,
          "zoom": 5
        },
        "locked": false
      }
    },
    {
      "id": "/basemap",
      "type": "MaplibreBasemapOp",
      "position": { "x": 150, "y": 200 },
      "data": {
        "inputs": {},
        "locked": false
      }
    },
    {
      "id": "/deck",
      "type": "DeckRendererOp",
      "position": { "x": 150, "y": 0 },
      "data": {
        "inputs": {},
        "locked": false
      }
    },
    {
      "id": "/out",
      "type": "OutOp",
      "position": { "x": 450, "y": 0 },
      "data": {
        "inputs": {},
        "locked": false
      }
    }
  ],
  "edges": [
    {
      "id": "/file.out.data->/scatter.par.data",
      "source": "/file",
      "sourceHandle": "out.data",
      "target": "/scatter",
      "targetHandle": "par.data"
    },
    {
      "id": "/position.out.accessor->/scatter.par.getPosition",
      "source": "/position",
      "sourceHandle": "out.accessor",
      "target": "/scatter",
      "targetHandle": "par.getPosition"
    },
    {
      "id": "/radius.out.accessor->/scatter.par.getRadius",
      "source": "/radius",
      "sourceHandle": "out.accessor",
      "target": "/scatter",
      "targetHandle": "par.getRadius"
    },
    {
      "id": "/viewstate.out.viewState->/basemap.par.viewState",
      "source": "/viewstate",
      "sourceHandle": "out.viewState",
      "target": "/basemap",
      "targetHandle": "par.viewState"
    },
    {
      "id": "/basemap.out.maplibre->/deck.par.basemap",
      "source": "/basemap",
      "sourceHandle": "out.maplibre",
      "target": "/deck",
      "targetHandle": "par.basemap"
    },
    {
      "id": "/scatter.out.layer->/deck.par.layers",
      "source": "/scatter",
      "sourceHandle": "out.layer",
      "target": "/deck",
      "targetHandle": "par.layers"
    },
    {
      "id": "/deck.out.vis->/out.par.vis",
      "source": "/deck",
      "sourceHandle": "out.vis",
      "target": "/out",
      "targetHandle": "par.vis"
    }
  ],
  "timeline": {
    "sheetsById": {
      "Noodles": {
        "staticOverrides": {
          "byObject": {}
        }
      }
    },
    "definitionVersion": "0.4.0",
    "revisionHistory": []
  }
}
