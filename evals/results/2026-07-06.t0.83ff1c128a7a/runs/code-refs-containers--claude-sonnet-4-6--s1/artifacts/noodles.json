      "data": {
        "inputs": {},
        "locked": false
      }
    },
    {
      "id": "/processing/transform",
      "type": "CodeOp",
      "position": { "x": 250, "y": 100 },
      "parentId": "/processing",
      "data": {
        "inputs": {
          "code": [
            "const cutoff = op('/min-magnitude').par.val",
            "return data.filter(d => +d.Magnitude >= cutoff).map(d => ({",
            "  longitude: +d.Longitude,",
            "  latitude: +d.Latitude,",
            "  magnitude: +d.Magnitude,",
            "  energy: Math.pow(10, 1.5 * +d.Magnitude)",
            "}))"
          ]
        },
        "locked": false
      }
    },
    {
      "id": "/processing/output",
      "type": "GraphOutputOp",
      "position": { "x": 500, "y": 100 },
      "parentId": "/processing",
      "data": {
        "inputs": {},
        "locked": false
      }
    },
    {
      "id": "/position-accessor",
      "type": "AccessorOp",
      "position": { "x": 250, "y": -160 },
      "data": {
        "inputs": {
          "expression": "[d.longitude, d.latitude]"
        },
        "locked": false
      }
    },
    {
      "id": "/radius-accessor",
      "type": "AccessorOp",
      "position": { "x": 250, "y": -40 },
      "data": {
        "inputs": {
          "expression": "Math.pow(d.energy, 1/5) * 150"
        },
        "locked": false
      }
    },
    {
