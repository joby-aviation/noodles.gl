{
  "version": 14,
  "name": "Quake Pipeline",
  "editorSettings": {
    "layoutMode": "noodles-on-top",
    "showOverlay": true
  },
  "nodes": [
    {
      "id": "/file",
      "type": "FileOp",
      "position": { "x": -300, "y": 0 },
      "data": {
        "inputs": {
          "format": "csv",
          "url": "@/data.csv"
        }
      }
    },
    {
      "id": "/min-magnitude",
      "type": "NumberOp",
      "position": { "x": -300, "y": 200 },
      "data": {
        "inputs": {
          "val": 4.0
        }
      }
    },
    {
      "id": "/processing",
      "type": "ContainerOp",
      "position": { "x": 100, "y": 0 },
      "data": {
        "inputs": {}
      }
    },
    {
      "id": "/processing/input",
      "type": "GraphInputOp",
      "position": { "x": -200, "y": 0 },
      "data": {
        "inputs": {}
      }
    },
    {
      "id": "/processing/filter",
      "type": "CodeOp",
      "position": { "x": 50, "y": 0 },
      "data": {
        "inputs": {
          "code": "const cutoff = op('../min-magnitude').par.val\nreturn data.filter(d => parseFloat(d.Magnitude) >= cutoff)"
        }
      }
    },
    {
      "id": "/processing/energy",
      "type": "CodeOp",
      "position": { "x": 300, "y": 0 },
      "data": {
        "inputs": {
          "code": "return data.map(d => ({ ...d, energy: Math.pow(10, 1.5 * parseFloat(d.Magnitude)) }))"
        }
      }
    },
    {
      "id": "/processing/output",
      "type": "GraphOutputOp",
      "position": { "x": 550, "y": 0 },
      "data": {
        "inputs": {}
      }
    },
    {
      "id": "/position-accessor",
      "type": "AccessorOp",
      "position": { "x": 450, "y": 200 },
      "data": {
        "inputs": {
          "expression": "[parseFloat(d.Longitude), parseFloat(d.Latitude)]"
        }
      }
    },
    {
      "id": "/radius-accessor",
      "type": "AccessorOp",
      "position": { "x": 450, "y": 350 },
      "data": {
        "inputs": {
          "expression": "Math.pow(d.energy, 1/3) * 50"
        }
      }
    },
    {
      "id": "/scatterplot",
      "type": "ScatterplotLayerOp",
      "position": { "x": 750, "y": 200 },
      "data": {
        "inputs": {
          "stroked": false,
          "opacity": 0.7,
          "getFillColor": "#ff4400ff",
          "radiusUnits": "meters",
          "radiusMinPixels": 2
        }
      }
    },
    {
      "id": "/basemap",
      "type": "MaplibreBasemapOp",
      "position": { "x": 750, "y": 450 },
      "data": {
        "inputs": {
          "mapStyle": "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
          "viewState": {
            "latitude": 37.5,
            "longitude": -119.5,
            "zoom": 5.5,
            "pitch": 0,
            "bearing": 0
          }
        }
      }
    },
    {
      "id": "/deck",
      "type": "DeckRendererOp",
      "position": { "x": 1050, "y": 200 },
      "data": {
        "inputs": {}
      }
    },
    {
      "id": "/out",
      "type": "OutOp",
      "position": { "x": 1350, "y": 200 },
      "data": {
        "inputs": {
          "display": "fixed",
          "width": 1920,
          "height": 1080,
          "lod": 2,
          "waitForData": true,
          "codec": "avc",
          "bitrateMbps": 10,
          "bitrateMode": "constant",
          "scaleControl": 0.3,
          "framerate": 30,
          "captureDelay": 50
        }
      }
    }
  ],
  "edges": [
    {
      "id": "/file.out.data->/processing.par.in",
      "source": "/file",
      "target": "/processing",
      "sourceHandle": "out.data",
      "targetHandle": "par.in"
    },
    {
      "id": "/processing/input.out.value->/processing/filter.par.data",
      "source": "/processing/input",
      "target": "/processing/filter",
      "sourceHandle": "out.value",
      "targetHandle": "par.data"
    },
    {
      "id": "/processing/filter.out.data->/processing/energy.par.data",
      "source": "/processing/filter",
      "target": "/processing/energy",
      "sourceHandle": "out.data",
      "targetHandle": "par.data"
    },
    {
      "id": "/processing/energy.out.data->/processing/output.par.value",
      "source": "/processing/energy",
      "target": "/processing/output",
      "sourceHandle": "out.data",
      "targetHandle": "par.value"
    },
    {
      "id": "/processing.out.out->/scatterplot.par.data",
      "source": "/processing",
      "target": "/scatterplot",
      "sourceHandle": "out.out",
      "targetHandle": "par.data"
    },
    {
      "id": "/position-accessor.out.accessor->/scatterplot.par.getPosition",
      "source": "/position-accessor",
      "target": "/scatterplot",
      "sourceHandle": "out.accessor",
      "targetHandle": "par.getPosition"
    },
    {
      "id": "/radius-accessor.out.accessor->/scatterplot.par.getRadius",
      "source": "/radius-accessor",
      "target": "/scatterplot",
      "sourceHandle": "out.accessor",
      "targetHandle": "par.getRadius"
    },
    {
      "id": "/scatterplot.out.layer->/deck.par.layers",
      "source": "/scatterplot",
      "target": "/deck",
      "sourceHandle": "out.layer",
      "targetHandle": "par.layers"
    },
    {
      "id": "/basemap.out.maplibre->/deck.par.basemap",
      "source": "/basemap",
      "target": "/deck",
      "sourceHandle": "out.maplibre",
      "targetHandle": "par.basemap"
    },
    {
      "id": "/deck.out.vis->/out.par.vis",
      "source": "/deck",
      "target": "/out",
      "sourceHandle": "out.vis",
      "targetHandle": "par.vis"
    }
  ],
  "viewport": {
    "x": 100,
    "y": 200,
    "zoom": 0.5
  },
  "timeline": {
    "sheetsById": {
      "Noodles": {
        "staticOverrides": {
          "byObject": {}
        }
      }
    },
    "definitionVersion": "0.4.0",
    "revisionHistory": []
  }
}
